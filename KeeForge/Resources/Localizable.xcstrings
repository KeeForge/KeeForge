        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos utiliza un formato de campos protegidos que KeeForge aún no admite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données utilise un format de champs protégés que KeeForge ne prend pas encore en charge."
          }
        }
      }
    },
    "This database uses an encryption format that KeeForge does not support yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank verwendet ein Verschlüsselungsformat, das KeeForge noch nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos utiliza un formato de cifrado que KeeForge aún no admite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données utilise un format de chiffrement que KeeForge ne prend pas encore en charge."
          }
        }
      }
    },
    "This database uses an older KeePass format that KeeForge does not support yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank verwendet ein älteres KeePass-Format, das KeeForge noch nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos utiliza un formato de KeePass más antiguo que KeeForge aún no admite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données utilise un ancien format KeePass que KeeForge ne prend pas encore en charge."
          }
        }
      }
    },
    "This database uses an unsupported protected-field stream." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank verwendet einen nicht unterstützten Datenstrom für geschützte Felder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos utiliza un flujo de campos protegidos no compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données utilise un flux de champs protégés non pris en charge."
          }
        }
      }
    },
    "This database's Argon2 settings require more memory or processing than this device can safely run. Lower the Argon2 settings in a desktop KeePass app and save the database, then try opening it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Argon2-Einstellungen dieser Datenbank erfordern mehr Speicher oder Rechenleistung, als dieses Gerät sicher ausführen kann. Verringern Sie die Argon2-Einstellungen in einer Desktop-KeePass-App, speichern Sie die Datenbank und versuchen Sie dann erneut, sie zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes de Argon2 de esta base de datos requieren más memoria o procesamiento de lo que este dispositivo puede ejecutar de forma segura. Reduzca los ajustes de Argon2 en una app de KeePass de escritorio, guarde la base de datos y vuelva a intentar abrirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paramètres Argon2 de cette base de données nécessitent plus de mémoire ou de calcul que ce que cet appareil peut exécuter en toute sécurité. Réduisez les paramètres Argon2 dans une app KeePass de bureau, enregistrez la base de données, puis réessayez de l'ouvrir."
          }
        }
      }
    },
    "This database's icons are stored in a form KeeForge cannot add to without risking the ones already there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Symbole dieser Datenbank liegen in einer Form vor, zu der KeeForge nichts hinzufügen kann, ohne die bereits vorhandenen zu gefährden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los iconos de esta base de datos están guardados en un formato al que KeeForge no puede añadir nada sin poner en riesgo los que ya contiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les icônes de cette base de données sont enregistrées sous une forme à laquelle KeeForge ne peut rien ajouter sans risquer celles qui s’y trouvent déjà."
          }
        }
      }
    },
    "This database's key derivation settings (%@ of memory × %@ iterations, %@ threads) exceed what this app can safely run. Lower the database's Argon2 settings in a desktop KeePass app and save it, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schlüsselableitungs-Einstellungen dieser Datenbank (%@ Arbeitsspeicher × %@ Iterationen, %@ Threads) überschreiten das, was diese App sicher ausführen kann. Verringern Sie die Argon2-Einstellungen der Datenbank in einer Desktop-KeePass-App, speichern Sie sie und versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes de derivación de clave de esta base de datos (%@ de memoria × %@ iteraciones, %@ hilos) superan lo que esta app puede ejecutar de forma segura. Reduzca los ajustes de Argon2 de la base de datos en una app de KeePass de escritorio, guárdela y vuelva a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paramètres de dérivation de clé de cette base de données (%@ de mémoire × %@ itérations, %@ threads) dépassent ce que cette app peut exécuter en toute sécurité. Réduisez les paramètres Argon2 de la base de données dans une app KeePass de bureau, enregistrez-la, puis réessayez."
          }
        }
      }
    },
    "This entry can no longer be edited. It may have been deleted, or the database may have been reopened read-only." : {
