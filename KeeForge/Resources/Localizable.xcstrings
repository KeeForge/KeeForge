    "The cloud service is busy right now. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cloud-Dienst ist gerade ausgelastet. Versuchen Sie es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio en la nube está ocupado en este momento. Inténtelo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service cloud est occupé actuellement. Réessayez dans un instant."
          }
        }
      }
    },
    "The cloud service is temporarily unavailable. Try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cloud-Dienst ist vorübergehend nicht verfügbar. Versuchen Sie es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio en la nube no está disponible temporalmente. Inténtelo de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service cloud est temporairement indisponible. Réessayez plus tard."
          }
        }
      }
    },
    "The cloud service rejected this file name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cloud-Dienst hat diesen Dateinamen abgelehnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio en la nube rechazó este nombre de archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service cloud a rejeté ce nom de fichier."
          }
        }
      }
    },
    "The cloud sign-in flow was cancelled before KeeForge could open the database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Cloud-Anmeldung wurde abgebrochen, bevor KeeForge die Datenbank öffnen konnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proceso de inicio de sesión en la nube se canceló antes de que KeeForge pudiera abrir la base de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La procédure de connexion au cloud a été annulée avant que KeeForge ne puisse ouvrir la base de données."
          }
        }
      }
    },
    "The current key file could not be read. Select it again or clear it, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle Schlüsseldatei konnte nicht gelesen werden. Wählen Sie sie erneut aus oder leeren Sie sie, und versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el archivo de clave actual. Selecciónelo de nuevo o bórrelo e inténtelo otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de clé actuel n'a pas pu être lu. Sélectionnez-le à nouveau ou effacez-le, puis réessayez."
          }
        }
      }
    },
    "The database appears corrupted or incomplete." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank scheint beschädigt oder unvollständig zu sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos parece dañada o incompleta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données semble corrompue ou incomplète."
          }
        }
      }
    },
    "The database changed outside KeeForge. Reload it or save your draft as a sibling conflict copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank wurde außerhalb von KeeForge geändert. Laden Sie sie neu oder sichern Sie Ihren Entwurf als Konfliktkopie neben der Datenbank."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos cambió fuera de KeeForge. Vuelva a cargarla o guarde su borrador como una copia de conflicto junto a ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données a été modifiée en dehors de KeeForge. Rechargez-la ou enregistrez votre brouillon en tant que copie de conflit adjacente."
          }
        }
      }
    },
    "The database file changed since it was opened. Reload the database and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei wurde seit dem Öffnen geändert. Laden Sie die Datenbank neu und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de base de datos cambió desde que se abrió. Recargue la base de datos e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données a été modifié depuis son ouverture. Rechargez la base de données et réessayez."
          }
        }
      }
    },
    "The database file could not be located." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei konnte nicht gefunden werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo localizar el archivo de la base de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données est introuvable."
          }
        }
      }
    },
    "The database file did not respond in time. Check that its server or network connection is available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei hat nicht rechtzeitig geantwortet. Prüfen Sie, ob der Server oder die Netzwerkverbindung verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de la base de datos no respondió a tiempo. Compruebe que su servidor o conexión de red esté disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données n'a pas répondu à temps. Vérifiez que son serveur ou sa connexion réseau est disponible."
          }
        }
      }
    },
    "The database file did not respond. Check that the server is reachable or connect to its network or VPN, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei hat nicht geantwortet. Prüfen Sie, ob der Server erreichbar ist, oder stellen Sie eine Verbindung zum zugehörigen Netzwerk oder VPN her. Versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de la base de datos no respondió. Compruebe que el servidor sea accesible o conéctese a su red o VPN y, después, inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données n'a pas répondu. Vérifiez que le serveur est accessible ou connectez-vous à son réseau ou VPN, puis réessayez."
          }
        }
      }
    },
    "The database file is in Recently Deleted in the Files app. Restore it in Files, or remove this database and add the current file again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei befindet sich in „Zuletzt gelöscht“ in der Dateien-App. Stellen Sie sie in der Dateien-App wieder her, oder entfernen Sie diese Datenbank und fügen Sie die aktuelle Datei erneut hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de la base de datos está en «Eliminados recientemente» en la app Archivos. Restáurelo en Archivos o quite esta base de datos y añada de nuevo el archivo actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données se trouve dans « Supprimés récemment » dans l'app Fichiers. Restaurez-le dans Fichiers, ou retirez cette base de données et ajoutez à nouveau le fichier actuel."
          }
        }
      }
    },
    "The database file was moved to Recently Deleted in the Files app — it may have been deleted, or replaced by a newer copy. Restore it in Files, or remove this database in KeeForge and add the current file again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei wurde in der Dateien-App nach „Zuletzt gelöscht“ verschoben – sie wurde möglicherweise gelöscht oder durch eine neuere Kopie ersetzt. Stellen Sie sie in der Dateien-App wieder her, oder entfernen Sie diese Datenbank in KeeForge und fügen Sie die aktuelle Datei erneut hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de la base de datos se movió a «Eliminados recientemente» en la app Archivos; es posible que se haya eliminado o que se haya sustituido por una copia más reciente. Restáurelo en Archivos o quite esta base de datos en KeeForge y añada de nuevo el archivo actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données a été déplacé vers « Supprimés récemment » dans l'app Fichiers — il a peut-être été supprimé ou remplacé par une copie plus récente. Restaurez-le dans Fichiers, ou retirez cette base de données dans KeeForge et ajoutez à nouveau le fichier actuel."
          }
        }
      }
    },
    "The database is locked. Unlock it and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank ist gesperrt. Entsperren Sie sie und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos está bloqueada. Desbloquéela e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données est verrouillée. Déverrouillez-la et réessayez."
          }
        }
      }
    },
    "The database is missing key derivation metadata." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Datenbank fehlen Metadaten zur Schlüsselableitung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la base de datos le faltan metadatos de derivación de claves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque à la base de données des métadonnées de dérivation de clé."
          }
        }
      }
    },
    "The database is missing key derivation salt data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Datenbank fehlen Salt-Daten zur Schlüsselableitung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la base de datos le faltan los datos de sal de derivación de claves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque à la base de données des données de sel pour la dérivation de clé."
          }
        }
      }
    },
    "The database is not ready to save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank kann noch nicht gesichert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos no está lista para guardarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données n'est pas prête à être enregistrée."
          }
        }
      }
    },
    "The database is too large for this server (HTTP 413)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank ist für diesen Server zu groß (HTTP 413)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos es demasiado grande para este servidor (HTTP 413)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données est trop volumineuse pour ce serveur (HTTP 413)."
          }
        }
      }
    },
    "The database requires this key file after the change. Clear it to unlock with the master password only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Änderung verlangt die Datenbank diese Schlüsseldatei. Leeren Sie sie, um nur mit dem Master-Passwort zu entsperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras el cambio, la base de datos requiere este archivo de clave. Bórrelo para desbloquear solo con la contraseña maestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la modification, la base de données exige ce fichier de clé. Effacez-le pour déverrouiller uniquement avec le mot de passe principal."
          }
        }
      }
    },
    "The entry will be moved to the recycle bin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Eintrag wird in den Papierkorb verschoben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada se moverá a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entrée sera déplacée vers la corbeille."
          }
        }
      }
    },
    "The entry's current contents are kept as a new history version, so you can undo this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktuelle Inhalt des Eintrags wird als neue Verlaufsversion aufbewahrt, Sie können das also rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido actual de la entrada se conserva como una nueva versión del historial, por lo que puede deshacer esta acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu actuel de l'entrée est conservé comme nouvelle version de l'historique, vous pouvez donc annuler cette action."
          }
        }
      }
    },
    "The last attempt did not turn it on. Open iOS AutoFill Settings and enable KeeForge there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der letzte Versuch hat es nicht aktiviert. Öffnen Sie die iOS-AutoFill-Einstellungen und aktivieren Sie KeeForge dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El último intento no lo activó. Abra los ajustes de autorrelleno de iOS y active KeeForge allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière tentative ne l'a pas activé. Ouvrez les réglages iOS de remplissage automatique et activez KeeForge à cet endroit."
          }
        }
      }
    },
    "The new database could not be verified after encryption." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Datenbank konnte nach der Verschlüsselung nicht verifiziert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar la nueva base de datos después del cifrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle base de données n'a pas pu être vérifiée après le chiffrement."
          }
        }
      }
    },
    "The new master key protects this database file from now on. Backups and copies made before the change still open with the previous master key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der neue Master-Schlüssel schützt diese Datenbankdatei ab jetzt. Sicherungen und Kopien, die vor der Änderung erstellt wurden, lassen sich weiterhin mit dem bisherigen Master-Schlüssel öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nueva clave maestra protege este archivo de base de datos a partir de ahora. Las copias de seguridad y copias hechas antes del cambio siguen abriéndose con la clave maestra anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle clé principale protège ce fichier de base de données à partir de maintenant. Les sauvegardes et copies effectuées avant la modification s'ouvrent toujours avec l'ancienne clé principale."
          }
        }
      }
    },
    "The password or key file didn't unlock this database. If you're sure they are correct, the file may be corrupted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank konnte mit dem Passwort oder der Schlüsseldatei nicht entsperrt werden. Wenn Sie sicher sind, dass Ihre Angaben korrekt sind, ist die Datei möglicherweise beschädigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña o el archivo de clave no desbloquearon esta base de datos. Si está seguro de que son correctos, es posible que el archivo esté dañado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe ou le fichier de clé n'a pas permis de déverrouiller cette base de données. Si vous êtes sûr qu'ils sont corrects, le fichier est peut-être corrompu."
          }
        }
      }
    },
    "The pending change for “%@” could not be uploaded because the copy in the cloud changed. KeeForge keeps a timestamped backup on this device before discarding it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausstehende Änderung für „%@“ konnte nicht hochgeladen werden, weil die Kopie in der Cloud geändert wurde. KeeForge behält vor dem Verwerfen eine Sicherungskopie mit Zeitstempel auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cambio pendiente de «%@» no se pudo cargar porque la copia en la nube cambió. KeeForge conserva una copia de seguridad con marca de tiempo en este dispositivo antes de descartarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modification en attente pour « %@ » n'a pas pu être envoyée, car la copie dans le cloud a changé. KeeForge conserve une sauvegarde horodatée sur cet appareil avant de l'abandonner."
          }
        }
      }
    },
    "The remote database could not be found." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Remote-Datenbank konnte nicht gefunden werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo encontrar la base de datos remota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données distante est introuvable."
          }
        }
      }
    },
    "The remote database is locked by another client. Try again shortly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Remote-Datenbank ist durch einen anderen Client gesperrt. Versuchen Sie es in Kürze erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos remota está bloqueada por otro cliente. Inténtelo de nuevo en breve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données distante est verrouillée par un autre client. Réessayez dans un instant."
          }
        }
      }
    },
    "The request is no longer available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anfrage ist nicht mehr verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud ya no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La demande n'est plus disponible."
          }
        }
      }
    },
    "The server address is not a valid URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Serveradresse ist keine gültige URL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección del servidor no es una URL válida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adresse du serveur n'est pas une URL valide."
          }
        }
      }
    },
    "The server address must start with https://." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Serveradresse muss mit https:// beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección del servidor debe empezar por https://."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adresse du serveur doit commencer par https://."
          }
