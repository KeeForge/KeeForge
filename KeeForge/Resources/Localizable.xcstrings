          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données a des modifications de remplissage automatique en attente. Laissez-les terminer leur synchronisation, puis réessayez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
