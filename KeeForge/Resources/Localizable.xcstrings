    "Auto-Unlock with Face ID" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch mit Face ID entsperren"
          }
        }
      }
    },
    "Auto-Unlock with Face ID prompts after a database is opened. When background locking is off, KeeForge still uses the auto-lock timeout and locks the next time the app becomes active after that deadline has passed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Öffnen einer Datenbank fordert KeeForge zur Entsperrung mit Face ID auf. Wenn das Sperren im Hintergrund deaktiviert ist, verwendet KeeForge weiterhin die Zeit bis zur automatischen Sperre und sperrt die Datenbank, sobald die App nach Ablauf dieser Frist wieder aktiv wird."
          }
        }
      }
    },
    "Auto-Unlock with Touch ID" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch mit Touch ID entsperren"
