    "Add a cloud database from the database list to connect an account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie in der Datenbankliste eine Cloud-Datenbank hinzu, um ein Konto zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añada una base de datos en la nube desde la lista de bases de datos para conectar una cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une base de données cloud depuis la liste des bases de données pour connecter un compte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
