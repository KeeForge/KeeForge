          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge todavía no está habilitado como proveedor de Autorrelleno. Actívelo en «General» > «Autorrelleno y contraseñas» para rellenar contraseñas en Safari y otras aplicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge n'est pas encore activé en tant que fournisseur de Remplissage automatique. Activez-le dans « Général » > « Remplissage automatique et mots de passe » pour remplir les mots de passe dans Safari et d'autres apps."
          }
