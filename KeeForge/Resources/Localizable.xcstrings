          }
        }
      }
    },
    "The database file could not be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei konnte nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el archivo de la base de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données n'a pas pu être lu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取数据库文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取資料庫檔案。"
          }
        }
      }
    },
    "The database file did not respond in time. Check that its server or network connection is available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei hat nicht rechtzeitig geantwortet. Prüfen Sie, ob der Server oder die Netzwerkverbindung verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de la base de datos no respondió a tiempo. Compruebe que su servidor o conexión de red esté disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données n'a pas répondu à temps. Vérifiez que son serveur ou sa connexion réseau est disponible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库文件未及时响应。请检查其服务器或网络连接是否可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫檔案未及時回應。請檢查其伺服器或網路連線是否可用。"
          }
        }
      }
    },
    "The database file did not respond. Check that the server is reachable or connect to its network or VPN, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei hat nicht geantwortet. Prüfen Sie, ob der Server erreichbar ist, oder stellen Sie eine Verbindung zum zugehörigen Netzwerk oder VPN her. Versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de la base de datos no respondió. Compruebe que el servidor sea accesible o conéctese a su red o VPN y, después, inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données n'a pas répondu. Vérifiez que le serveur est accessible ou connectez-vous à son réseau ou VPN, puis réessayez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库文件没有响应。请检查服务器是否可访问，或连接到其网络或 VPN，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫檔案沒有回應。請檢查伺服器是否可連線，或連接到其網路或 VPN，然後再試一次。"
          }
        }
      }
    },
    "The database file is in Recently Deleted in the Files app. Restore it in Files, or remove this database and add the current file again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei befindet sich in „Zuletzt gelöscht“ in der Dateien-App. Stellen Sie sie in der Dateien-App wieder her, oder entfernen Sie diese Datenbank und fügen Sie die aktuelle Datei erneut hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de la base de datos está en «Eliminados recientemente» en la app Archivos. Restáurelo en Archivos o quite esta base de datos y añada de nuevo el archivo actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données se trouve dans « Supprimés récemment » dans l'app Fichiers. Restaurez-le dans Fichiers, ou retirez cette base de données et ajoutez à nouveau le fichier actuel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库文件位于“文件”App 的“最近删除”中。请在“文件”中恢复它，或移除此数据库并重新添加当前文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫檔案位於「檔案」App 的「最近刪除」中。請在「檔案」中回復它，或移除此資料庫並重新加入目前的檔案。"
          }
        }
      }
    },
    "The database file was moved to Recently Deleted in the Files app — it may have been deleted, or replaced by a newer copy. Restore it in Files, or remove this database in KeeForge and add the current file again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei wurde in der Dateien-App nach „Zuletzt gelöscht“ verschoben – sie wurde möglicherweise gelöscht oder durch eine neuere Kopie ersetzt. Stellen Sie sie in der Dateien-App wieder her, oder entfernen Sie diese Datenbank in KeeForge und fügen Sie die aktuelle Datei erneut hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de la base de datos se movió a «Eliminados recientemente» en la app Archivos; es posible que se haya eliminado o que se haya sustituido por una copia más reciente. Restáurelo en Archivos o quite esta base de datos en KeeForge y añada de nuevo el archivo actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données a été déplacé vers « Supprimés récemment » dans l'app Fichiers — il a peut-être été supprimé ou remplacé par une copie plus récente. Restaurez-le dans Fichiers, ou retirez cette base de données dans KeeForge et ajoutez à nouveau le fichier actuel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库文件已被移至“文件”App 中的“最近删除”——它可能已被删除，或被更新的副本替换。请在“文件”中恢复它，或在 KeeForge 中移除此数据库并重新添加当前文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫檔案已被移至「檔案」App 中的「最近刪除項目」——它可能已被刪除，或被較新的副本取代。請在「檔案」中回復它，或在 KeeForge 中移除此資料庫並重新加入目前的檔案。"
          }
        }
      }
    },
    "The database is locked. Unlock it and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank ist gesperrt. Entsperren Sie sie und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos está bloqueada. Desbloquéela e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données est verrouillée. Déverrouillez-la et réessayez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库已锁定。请解锁后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫已鎖定。請解鎖後再試一次。"
          }
        }
      }
    },
    "The database is missing key derivation metadata." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Datenbank fehlen Metadaten zur Schlüsselableitung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la base de datos le faltan metadatos de derivación de claves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque à la base de données des métadonnées de dérivation de clé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库缺少密钥派生元数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫缺少金鑰衍生中繼資料。"
          }
        }
      }
    },
    "The database is missing key derivation salt data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Datenbank fehlen Salt-Daten zur Schlüsselableitung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la base de datos le faltan los datos de sal de derivación de claves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque à la base de données des données de sel pour la dérivation de clé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库缺少密钥派生盐值数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫缺少金鑰衍生鹽值資料。"
          }
        }
      }
    },
    "The database is not ready to save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank kann noch nicht gesichert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos no está lista para guardarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données n'est pas prête à être enregistrée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库尚未准备好保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫尚未準備好儲存。"
          }
        }
      }
    },
    "The database is too large for this server (HTTP 413)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank ist für diesen Server zu groß (HTTP 413)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos es demasiado grande para este servidor (HTTP 413)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données est trop volumineuse pour ce serveur (HTTP 413)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库过大，超出此服务器的限制（HTTP 413）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫過大，超出此伺服器的限制（HTTP 413）。"
          }
        }
      }
    },
    "The database requires this key file after the change. Clear it to unlock with the master password only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Änderung verlangt die Datenbank diese Schlüsseldatei. Leeren Sie sie, um nur mit dem Master-Passwort zu entsperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras el cambio, la base de datos requiere este archivo de clave. Bórrelo para desbloquear solo con la contraseña maestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la modification, la base de données exige ce fichier de clé. Effacez-le pour déverrouiller uniquement avec le mot de passe principal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改后，数据库将需要此密钥文件。清除它即可仅使用主密码解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改後，資料庫將需要此金鑰檔案。清除它即可僅使用主密碼解鎖。"
          }
        }
      }
    },
    "The database will require only the key file to unlock. Anyone with the key file can open it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Entsperren der Datenbank ist dann nur noch die Schlüsseldatei erforderlich. Jeder, der die Schlüsseldatei besitzt, kann sie öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos solo requerirá el archivo de clave para desbloquearse. Cualquiera que tenga el archivo de clave podrá abrirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données ne nécessitera plus que le fichier de clé pour être déverrouillée. Toute personne disposant du fichier de clé pourra l'ouvrir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库将仅需密钥文件即可解锁。任何拥有该密钥文件的人都能打开它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫將僅需金鑰檔案即可解鎖。任何擁有該金鑰檔案的人都能開啟它。"
          }
        }
      }
    },
    "The entry will be moved to the recycle bin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Eintrag wird in den Papierkorb verschoben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada se moverá a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entrée sera déplacée vers la corbeille."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该条目将被移至回收站。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此項目將移至資源回收筒。"
          }
        }
      }
    },
    "The entry's current contents are kept as a new history version, so you can undo this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktuelle Inhalt des Eintrags wird als neue Verlaufsversion aufbewahrt, Sie können das also rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido actual de la entrada se conserva como una nueva versión del historial, por lo que puede deshacer esta acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu actuel de l'entrée est conservé comme nouvelle version de l'historique, vous pouvez donc annuler cette action."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条目的当前内容会保留为新的历史记录版本，因此你可以撤销此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目的目前內容會保留為新的歷史記錄版本，因此你可以復原此操作。"
          }
        }
      }
    },
    "The last attempt did not turn it on. Open iOS AutoFill Settings and enable KeeForge there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der letzte Versuch hat es nicht aktiviert. Öffnen Sie die iOS-AutoFill-Einstellungen und aktivieren Sie KeeForge dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El último intento no lo activó. Abra los ajustes de autorrelleno de iOS y active KeeForge allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière tentative ne l'a pas activé. Ouvrez les réglages iOS de remplissage automatique et activez KeeForge à cet endroit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次尝试未能开启该功能。请打开 iOS 自动填充设置并在其中启用 KeeForge。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次嘗試未能開啟此功能。請前往 iOS 自動填寫設定並在其中啟用 KeeForge。"
          }
        }
      }
    },
    "The new database could not be verified after encryption." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Datenbank konnte nach der Verschlüsselung nicht verifiziert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar la nueva base de datos después del cifrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle base de données n'a pas pu être vérifiée après le chiffrement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新数据库在加密后无法通过验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新資料庫在加密後無法通過驗證。"
          }
        }
      }
    },
    "The new master key protects this database file from now on. Backups and copies made before the change still open with the previous master key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der neue Master-Schlüssel schützt diese Datenbankdatei ab jetzt. Sicherungen und Kopien, die vor der Änderung erstellt wurden, lassen sich weiterhin mit dem bisherigen Master-Schlüssel öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nueva clave maestra protege este archivo de base de datos a partir de ahora. Las copias de seguridad y copias hechas antes del cambio siguen abriéndose con la clave maestra anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle clé principale protège ce fichier de base de données à partir de maintenant. Les sauvegardes et copies effectuées avant la modification s'ouvrent toujours avec l'ancienne clé principale."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从现在起，新的主密钥将保护此数据库文件。更改前创建的备份和副本仍可用之前的主密钥打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從現在起，新的主金鑰將保護此資料庫檔案。更改前建立的備份與副本仍可用先前的主金鑰開啟。"
          }
        }
      }
    },
    "The new master key was uploaded, but the local copy could not be updated. The cloud file now requires the new master key." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der neue Master-Schlüssel wurde hochgeladen, aber die lokale Kopie konnte nicht aktualisiert werden. Die Cloud-Datei erfordert jetzt den neuen Master-Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nueva clave maestra se subió, pero la copia local no se pudo actualizar. El archivo en la nube ahora requiere la nueva clave maestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle clé principale a été téléversée, mais la copie locale n'a pas pu être mise à jour. Le fichier cloud requiert désormais la nouvelle clé principale."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的主密钥已上传，但本地副本无法更新。云端文件现在需要新的主密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的主金鑰已上傳，但本機副本無法更新。雲端檔案現在需要新的主金鑰。"
          }
        }
      }
    },
    "The other copy had no new changes to add. Your changes were saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die andere Kopie enthielt keine neuen Änderungen. Ihre Änderungen wurden gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La otra copia no tenía cambios nuevos que añadir. Sus cambios se guardaron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autre copie ne contenait aucune nouvelle modification. Vos modifications ont été enregistrées."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个副本没有新的更改。你的更改已保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個副本沒有新的變更。你的變更已儲存。"
          }
        }
      }
    },
    "The other copy of this database could not be opened. It may use a different master key, or be an older KDBX 3.1 file. Reload the database or save your changes as a conflict copy instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die andere Kopie dieser Datenbank konnte nicht geöffnet werden. Möglicherweise verwendet sie einen anderen Master-Schlüssel oder ist eine ältere KDBX-3.1-Datei. Laden Sie die Datenbank stattdessen neu oder sichern Sie Ihre Änderungen als Konfliktkopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir la otra copia de esta base de datos. Puede que use una clave maestra distinta o que sea un archivo KDBX 3.1 más antiguo. En su lugar, vuelva a cargar la base de datos o guarde sus cambios como una copia de conflicto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autre copie de cette base de données n’a pas pu être ouverte. Elle utilise peut-être une autre clé principale, ou il s’agit d’un ancien fichier KDBX 3.1. Rechargez plutôt la base de données ou enregistrez vos modifications en tant que copie de conflit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开此数据库的另一个副本。它可能使用了不同的主密钥，或者是较旧的 KDBX 3.1 文件。请改为重新加载数据库，或将更改保存为冲突副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟此資料庫的另一個副本。它可能使用了不同的主金鑰，或是較舊的 KDBX 3.1 檔案。請改為重新載入資料庫，或將變更儲存為衝突副本。"
          }
        }
      }
    },
    "The password or key file didn't unlock this database. If you're sure they are correct, the file may be corrupted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank konnte mit dem Passwort oder der Schlüsseldatei nicht entsperrt werden. Wenn Sie sicher sind, dass Ihre Angaben korrekt sind, ist die Datei möglicherweise beschädigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña o el archivo de clave no desbloquearon esta base de datos. Si está seguro de que son correctos, es posible que el archivo esté dañado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe ou le fichier de clé n'a pas permis de déverrouiller cette base de données. Si vous êtes sûr qu'ils sont corrects, le fichier est peut-être corrompu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码或密钥文件无法解锁此数据库。如果你确定它们正确无误，文件可能已损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼或金鑰檔案無法解鎖此資料庫。如果你確定它們正確無誤，檔案可能已損毀。"
          }
        }
      }
    },
    "The pending change for “%@” could not be uploaded because the copy in the cloud changed. KeeForge keeps a timestamped backup on this device before discarding it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausstehende Änderung für „%@“ konnte nicht hochgeladen werden, weil die Kopie in der Cloud geändert wurde. KeeForge behält vor dem Verwerfen eine Sicherungskopie mit Zeitstempel auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cambio pendiente de «%@» no se pudo cargar porque la copia en la nube cambió. KeeForge conserva una copia de seguridad con marca de tiempo en este dispositivo antes de descartarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modification en attente pour « %@ » n'a pas pu être envoyée, car la copie dans le cloud a changé. KeeForge conserve une sauvegarde horodatée sur cet appareil avant de l'abandonner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于云端的副本已发生变化，“%@”的待处理更改无法上传。KeeForge 会在丢弃该更改前，在此设备上保留带时间戳的备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於雲端的副本已變更，「%@」的待處理更動無法上傳。KeeForge 會在捨棄該更動前，在此裝置上保留帶時間戳記的備份。"
          }
        }
      }
    },
    "The remote database could not be found." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Remote-Datenbank konnte nicht gefunden werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo encontrar la base de datos remota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données distante est introuvable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到远程数据库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到遠端資料庫。"
          }
        }
      }
    },
    "The remote database is locked by another client. Try again shortly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Remote-Datenbank ist durch einen anderen Client gesperrt. Versuchen Sie es in Kürze erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos remota está bloqueada por otro cliente. Inténtelo de nuevo en breve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données distante est verrouillée par un autre client. Réessayez dans un instant."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程数据库已被其他客户端锁定。请稍后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端資料庫已被其他用戶端鎖定。請稍後再試。"
          }
        }
      }
    },
    "The request is no longer available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anfrage ist nicht mehr verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud ya no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La demande n'est plus disponible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该请求已不可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此要求已無法使用。"
          }
        }
      }
    },
    "The server address is not a valid URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Serveradresse ist keine gültige URL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección del servidor no es una URL válida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adresse du serveur n'est pas une URL valide."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器地址不是有效的 URL。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器位址不是有效的 URL。"
          }
        }
      }
    },
    "The server address must start with https://." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Serveradresse muss mit https:// beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección del servidor debe empezar por https://."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adresse du serveur doit commencer par https://."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器地址必须以 https:// 开头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器位址必須以 https:// 開頭。"
          }
        }
      }
    },
    "The server denied access. Check that this account has permission for this file or folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat den Zugriff verweigert. Prüfen Sie, ob dieses Konto die Berechtigung für diese Datei oder diesen Ordner besitzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor denegó el acceso. Compruebe que esta cuenta tenga permiso para este archivo o carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé l'accès. Vérifiez que ce compte dispose des autorisations nécessaires pour ce fichier ou ce dossier."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器拒绝访问。请检查此账户是否拥有此文件或文件夹的权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器拒絕存取。請檢查此帳號是否擁有此檔案或資料夾的權限。"
          }
        }
      }
    },
    "The server is out of storage space (HTTP 507)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Server ist kein Speicherplatz mehr verfügbar (HTTP 507)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor se quedó sin espacio de almacenamiento (HTTP 507)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n'a plus d'espace de stockage disponible (HTTP 507)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器存储空间不足（HTTP 507）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器儲存空間不足（HTTP 507）。"
          }
        }
      }
    },
    "The server rejected this request (HTTP %lld)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat diese Anfrage abgelehnt (HTTP %lld)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor rechazó esta solicitud (HTTP %lld)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a rejeté cette requête (HTTP %lld)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器拒绝了此请求（HTTP %lld）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器拒絕了此要求（HTTP %lld）。"
          }
        }
      }
    },
    "The server reported an error (HTTP %lld). Try again shortly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat einen Fehler gemeldet (HTTP %lld). Versuchen Sie es in Kürze erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor notificó un error (HTTP %lld). Inténtelo de nuevo en breve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a signalé une erreur (HTTP %lld). Réessayez dans un instant."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器报告了一个错误（HTTP %lld）。请稍后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器回報錯誤（HTTP %lld）。請稍後再試。"
          }
        }
      }
    },
    "The server returned an unexpected response (HTTP %lld)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat eine unerwartete Antwort zurückgegeben (HTTP %lld)."
          }
