        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor devolvió una respuesta inesperada (HTTP %lld)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a renvoyé une réponse inattendue (HTTP %lld)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器返回了意外的响应（HTTP %lld）。"
