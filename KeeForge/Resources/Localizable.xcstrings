            "state" : "translated",
            "value" : "KeeForge est activé en tant que fournisseur de Remplissage automatique."
          }
        }
      }
    },
    "KeeForge is free and open source. Tips help support development. ❤️" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge ist kostenlos und quelloffen. Trinkgelder unterstützen die Entwicklung. ❤️"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge es gratuita y de código abierto. Las propinas ayudan a respaldar el desarrollo. ❤️"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge est gratuit et open source. Les pourboires aident à soutenir le développement. ❤️"
          }
        }
      }
    },
    "KeeForge is now fully translated into French and Spanish throughout the app and AutoFill." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge ist jetzt in der gesamten App und in AutoFill vollständig ins Französische und Spanische übersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge ahora está completamente traducida al francés y al español en toda la app y Autorrelleno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge est désormais entièrement traduit en français et en espagnol dans l’app et le Remplissage automatique."
          }
        }
      }
    },
    "KeeForge is now fully translated into German throughout the app and AutoFill." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge ist jetzt in der gesamten App und in AutoFill vollständig ins Deutsche übersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
