    "Cloud databases are cached locally and refreshed whenever you open them in the main app. AutoFill uses the cached copy only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud-Datenbanken werden lokal zwischengespeichert und bei jedem Öffnen in der Haupt-App aktualisiert. AutoFill verwendet nur die Cache-Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las bases de datos en la nube se almacenan en caché localmente y se actualizan cada vez que las abre en la app principal. El autorrelleno solo utiliza la copia en caché."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bases de données cloud sont mises en cache localement et actualisées à chaque ouverture dans l'app principale. Le remplissage automatique utilise uniquement la copie en cache."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云数据库会缓存在本地，并在你于主 App 中打开时刷新。自动填充仅使用缓存副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雲端資料庫會快取在本機，並在你於主 App 中開啟時重新整理。自動填寫僅使用快取副本。"
          }
        }
      }
    },
