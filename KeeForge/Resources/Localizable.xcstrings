    "Legacy KDBX 3.1 databases can be opened, but KeeForge intentionally keeps them read-only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere KDBX-3.1-Datenbanken können geöffnet werden, KeeForge lässt sie jedoch bewusst nur schreibgeschützt zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las bases de datos KDBX 3.1 antiguas se pueden abrir, pero KeeForge las mantiene intencionadamente en modo de solo lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les anciennes bases de données KDBX 3.1 peuvent être ouvertes, mais KeeForge les maintient volontairement en lecture seule."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以打开旧版 KDBX 3.1 数据库，但 KeeForge 有意将其保持为只读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以開啟舊版 KDBX 3.1 資料庫，但 KeeForge 刻意將其保持為唯讀。"
          }
        }
      }
    },
    "Legacy KDBX 3.1 databases can be opened, but KeeForge only allows them in read-only mode." : {
      "localizations" : {
