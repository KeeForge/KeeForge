    "Choose KeeForge when an app or website offers to add a passkey, and save it directly to your default AutoFill database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle KeeForge, wenn eine App oder Website anbietet, einen Passkey hinzuzufügen, und speichere ihn direkt in deiner standardmäßigen AutoFill-Datenbank."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige KeeForge cuando una app o sitio web te ofrezca añadir una llave de acceso y guárdala directamente en tu base de datos predeterminada de Autorrelleno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez KeeForge lorsqu’une app ou un site web propose d’ajouter une clé d’accès, puis enregistrez-la directement dans votre base de données par défaut pour le Remplissage automatique."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 App 或网站提供添加通行密钥时，选择 KeeForge，即可将其直接保存到默认的自动填充数据库。"
          }
        },
        "zh-Hant" : {
