        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此資料庫為唯讀。請開啟 KeeForge 以啟用編輯。"
          }
        }
      }
    },
    "This database is unavailable. Return to the database list to remove it or refresh its bookmark." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank ist nicht verfügbar. Kehren Sie zur Datenbankliste zurück, um sie zu entfernen oder ihr Lesezeichen zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos no está disponible. Vuelva a la lista de bases de datos para quitarla o actualizar su marcador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données n'est pas disponible. Revenez à la liste des bases de données pour la retirer ou actualiser son signet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此数据库不可用。请返回数据库列表将其移除或刷新其书签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此資料庫無法使用。請返回資料庫列表將其移除或重新整理其書籤。"
          }
        }
      }
    },
    "This database keeps no earlier versions, so the entry's current contents will be lost. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank bewahrt keine früheren Versionen auf, der aktuelle Inhalt des Eintrags geht also verloren. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos no conserva versiones anteriores, por lo que el contenido actual de la entrada se perderá. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données ne conserve aucune version antérieure, le contenu actuel de l'entrée sera donc perdu. Cette action est irréversible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此数据库不保留早期版本，因此条目的当前内容将会丢失。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此資料庫不保留先前版本，因此項目的目前內容將會遺失。此操作無法復原。"
          }
        }
      }
    },
    "This database needs about %@ of memory to unlock, more than the %@ AutoFill is allowed to use. Open the entry in the KeeForge app, or lower the database's Argon2 memory setting in a desktop KeePass app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank benötigt zum Entsperren etwa %1$@ Arbeitsspeicher — mehr als die %2$@, die AutoFill verwenden darf. Öffnen Sie den Eintrag in der KeeForge-App oder verringern Sie die Argon2-Speichereinstellung der Datenbank in einer KeePass-App für den Computer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This database needs about %1$@ of memory to unlock, more than the %2$@ AutoFill is allowed to use. Open the entry in the KeeForge app, or lower the database's Argon2 memory setting in a desktop KeePass app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos necesita unos %1$@ de memoria para desbloquearse, más de los %2$@ que AutoFill puede usar. Abra la entrada en la app KeeForge, o reduzca el ajuste de memoria Argon2 de la base de datos en una app KeePass de escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données a besoin d’environ %1$@ de mémoire pour être déverrouillée, soit plus que les %2$@ autorisés pour AutoFill. Ouvrez l’entrée dans l’app KeeForge, ou réduisez le réglage de mémoire Argon2 de la base de données dans une app KeePass pour ordinateur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解锁此数据库大约需要 %1$@ 内存，超出了自动填充可使用的 %2$@ 上限。请在 KeeForge App 中打开该条目，或在桌面版 KeePass 应用中调低数据库的 Argon2 内存设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解鎖此資料庫大約需要 %1$@ 記憶體，超出了自動填寫可使用的 %2$@ 上限。請在 KeeForge App 中開啟該項目，或在桌面版 KeePass App 中調低資料庫的 Argon2 記憶體設定。"
          }
        }
      }
    },
    "This database uses a KeePass format that KeeForge does not support yet." : {
