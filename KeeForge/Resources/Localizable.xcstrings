    "A parent group is hidden from Search & AutoFill. Turn this off to show this group anyway." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine übergeordnete Gruppe ist aus Suche & AutoFill ausgeblendet. Deaktivieren Sie diese Option, um diese Gruppe dennoch anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un grupo superior está oculto de la búsqueda y el autorrelleno. Desactive esta opción para mostrar este grupo de todas formas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un groupe parent est masqué de la recherche et du remplissage automatique. Désactivez cette option pour afficher ce groupe malgré tout."
          }
        }
      }
    },
