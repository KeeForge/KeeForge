    },
    "KeeForge couldn't reach the cloud provider. Try again when your connection is back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge konnte den Cloud-Anbieter nicht erreichen. Versuchen Sie es erneut, sobald Ihre Verbindung wiederhergestellt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge no pudo conectar con el proveedor de la nube. Vuelva a intentarlo cuando recupere la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge n'a pas pu joindre le fournisseur cloud. Réessayez lorsque votre connexion sera rétablie."
