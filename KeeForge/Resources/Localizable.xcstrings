    "Browse the earlier versions of an entry and restore one. The current contents are kept, so you can undo it. Thanks to @miquno." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blättern Sie durch die früheren Versionen eines Eintrags und stellen Sie eine davon wieder her. Der aktuelle Inhalt bleibt erhalten, sodass Sie den Schritt rückgängig machen können. Dank an @miquno."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
