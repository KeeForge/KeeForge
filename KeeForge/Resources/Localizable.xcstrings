    "To fill passwords from KeeForge in Safari and other apps, enable KeeForge in iOS AutoFill settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Passwörter aus KeeForge in Safari und anderen Apps auszufüllen, aktivieren Sie KeeForge in den iOS-AutoFill-Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para rellenar contraseñas de KeeForge en Safari y otras apps, active KeeForge en los ajustes de autorrelleno de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour remplir des mots de passe depuis KeeForge dans Safari et d'autres apps, activez KeeForge dans les réglages de remplissage automatique iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要在 Safari 和其他 App 中填充 KeeForge 的密码，请在 iOS 自动填充设置中启用 KeeForge。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要在 Safari 和其他 App 中填寫 KeeForge 的密碼，請在 iOS 自動填寫設定中啟用 KeeForge。"
          }
        }
      }
    },
    "To fill passwords from KeeForge in Safari and other apps, enable KeeForge in System Settings under General > AutoFill & Passwords." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Passwörter aus KeeForge in Safari und anderen Apps auszufüllen, aktivieren Sie KeeForge in den Systemeinstellungen unter „Allgemein“ > „AutoFill & Passwörter“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para rellenar contraseñas de KeeForge en Safari y otras apps, active KeeForge en Ajustes del Sistema, en «General» > «Autorrelleno y contraseñas»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour remplir des mots de passe depuis KeeForge dans Safari et d'autres apps, activez KeeForge dans Réglages Système, sous « Général » > « Remplissage automatique et mots de passe »."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
