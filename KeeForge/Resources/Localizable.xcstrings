    },
    "This account is disconnected. KeeForge keeps the cached copy until you remove the database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto ist getrennt. KeeForge behält die Cache-Kopie, bis Sie die Datenbank entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta está desconectada. KeeForge conserva la copia en caché hasta que quite la base de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte est déconnecté. KeeForge conserve la copie mise en cache jusqu'à ce que vous retiriez la base de données."
          }
        }
      }
    },
    "This build of KeeForge is missing the cloud sync configuration it needs to open that database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesem KeeForge-Build fehlt die Cloud-Synchronisierungskonfiguration, die zum Öffnen dieser Datenbank erforderlich ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A esta compilación de KeeForge le falta la configuración de sincronización en la nube necesaria para abrir esa base de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque à cette version de KeeForge la configuration de synchronisation cloud nécessaire pour ouvrir cette base de données."
          }
        }
      }
    },
    "This cloud provider is not available in the current build." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Cloud-Anbieter ist im aktuellen Build nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este proveedor en la nube no está disponible en la compilación actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fournisseur cloud n'est pas disponible dans cette version."
          }
        }
      }
    },
    "This database changed in the cloud. Reload before saving again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank wurde in der Cloud geändert. Laden Sie sie vor dem erneuten Sichern neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos cambió en la nube. Vuelva a cargarla antes de guardar de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données a été modifiée dans le cloud. Rechargez-la avant de l'enregistrer à nouveau."
          }
        }
      }
    },
    "This database has pending AutoFill changes. Let them finish syncing, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank hat ausstehende AutoFill-Änderungen. Lassen Sie sie zuerst fertig synchronisieren und versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos tiene cambios de autorrelleno pendientes. Deje que terminen de sincronizarse e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données a des modifications de remplissage automatique en attente. Laissez-les terminer leur synchronisation, puis réessayez."
          }
        }
      }
    },
    "This database is read-only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank ist schreibgeschützt."
