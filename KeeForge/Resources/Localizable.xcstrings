    "This entry has no website address to download an icon from. Add one to the entry first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Eintrag hat keine Website-Adresse, von der ein Symbol geladen werden könnte. Fügen Sie dem Eintrag zuerst eine hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta entrada no tiene una dirección web de la que descargar un icono. Añada una a la entrada primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette entrée n’a pas d’adresse de site web depuis laquelle télécharger une icône. Ajoutez-en une à l’entrée d’abord."
          }
        },
        "zh-Hans" : {
