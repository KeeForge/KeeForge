          }
        }
      }
    },
    "KeeForge isn't enabled as an AutoFill provider yet. Turn it on under General > AutoFill & Passwords to fill passwords in Safari and other apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
