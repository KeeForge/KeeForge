{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "\"%@\" already exists in this group." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist in dieser Gruppe bereits vorhanden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ya existe en este grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » existe déjà dans ce groupe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此群组中已存在“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此群組中已存在「%@」。"
          }
        }
      }
    },
    "\"%@\" contains %@. The group and its contents will be moved to the recycle bin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ enthält %2$@. Die Gruppe und ihr Inhalt werden in den Papierkorb verschoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" contains %2$@. The group and its contents will be moved to the recycle bin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» contiene %2$@. El grupo y su contenido se moverán a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » contient %2$@. Le groupe et son contenu seront déplacés vers la corbeille."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”包含 %2$@。该群组及其内容将移至回收站。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」包含 %2$@。此群組及其內容將移至資源回收筒。"
          }
        }
      }
    },
    "\"%@\" contains %@. The group and its contents will be removed immediately and cannot be restored from KeeForge." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ enthält %2$@. Die Gruppe und ihr Inhalt werden sofort gelöscht und können in KeeForge nicht wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" contains %2$@. The group and its contents will be removed immediately and cannot be restored from KeeForge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» contiene %2$@. El grupo y su contenido se eliminarán inmediatamente y no podrán restaurarse desde KeeForge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » contient %2$@. Le groupe et son contenu seront supprimés immédiatement et ne pourront pas être restaurés depuis KeeForge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”包含 %2$@。该群组及其内容将被立即移除，且无法从 KeeForge 恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」包含 %2$@。此群組及其內容將立即移除，且無法從 KeeForge 回復。"
          }
        }
      }
    },
    "“%@” is already in your database list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist bereits in Ihrer Datenbankliste enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ya está en su lista de bases de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est déjà présent dans votre liste de bases de données."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已在你的数据库列表中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」已在你的資料庫列表中。"
          }
        }
      }
    },
    "“%@” is already used by a KeeForge-only database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird bereits von einer Datenbank verwendet, die nur in KeeForge verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ya lo utiliza una base de datos exclusiva de KeeForge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est déjà utilisé par une base de données disponible uniquement dans KeeForge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已被一个仅限 KeeForge 的数据库使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」已被僅限 KeeForge 的資料庫使用。"
          }
        }
      }
    },
    "“%@” will be removed from KeeForge, including its cached copy and saved biometric key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird aus KeeForge entfernt, einschließlich der Cache-Kopie und des gespeicherten biometrischen Schlüssels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se quitará de KeeForge, incluidas su copia en caché y su clave biométrica guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera retiré de KeeForge, y compris sa copie mise en cache et sa clé biométrique enregistrée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从 KeeForge 中移除，包括其缓存副本和已保存的生物识别密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將從 KeeForge 中移除，包括其快取副本和已儲存的生物辨識金鑰。"
          }
        }
      }
    },
    "(untitled)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(ohne Titel)"
          }
        },
