    "This account is disconnected. KeeForge keeps the cached copy until you remove the database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto ist getrennt. KeeForge behält die Cache-Kopie, bis Sie die Datenbank entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta está desconectada. KeeForge conserva la copia en caché hasta que quite la base de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte est déconnecté. KeeForge conserve la copie mise en cache jusqu'à ce que vous retiriez la base de données."
