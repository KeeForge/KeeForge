    "Database changed — open KeeForge to save" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenbank geändert — zum Sichern KeeForge öffnen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Base de datos modificada — abra KeeForge para guardar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Base de données modifiée — ouvrez KeeForge pour enregistrer"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库已更改，请打开 KeeForge 保存"
          }
        },
        "zh-Hant" : {
