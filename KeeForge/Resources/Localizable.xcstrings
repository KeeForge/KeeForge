      }
    },
    "HTTP sends your WebDAV username, password, and database traffic without encryption. Only use it on a local network you trust." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP überträgt Ihren WebDAV-Benutzernamen, Ihr Passwort und den Datenbankverkehr unverschlüsselt. Verwenden Sie es nur in einem lokalen Netzwerk, dem Sie vertrauen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP envía su nombre de usuario, contraseña y tráfico de la base de datos de WebDAV sin cifrar. Utilícelo solo en una red local de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP transmet votre nom d'utilisateur WebDAV, votre mot de passe et le trafic de la base de données sans chiffrement. Utilisez-le uniquement sur un réseau local de confiance."
          }
        }
      }
    },
