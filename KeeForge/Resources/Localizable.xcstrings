        }
      }
    },
    "KeeForge" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge"
          }
        }
      }
    },
    "KeeForge always locks on screen lock, screensaver, system sleep, and user switching. The stricter option also locks whenever another app becomes active." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge sperrt sich immer bei Bildschirmsperre, Bildschirmschoner, Ruhezustand des Systems und Benutzerwechsel. Die strengere Option sperrt außerdem, sobald eine andere App aktiv wird."
          }
        }
      }
    },
    "KeeForge can now open older KeePass 3.1 vaults and databases protected with Twofish — and keeps their original encryption when you save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge kann jetzt ältere KeePass-3.1-Tresore und mit Twofish geschützte Datenbanken öffnen – und behält beim Speichern deren ursprüngliche Verschlüsselung bei."
          }
        }
      }
    },
    "KeeForge couldn't access the selected database file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge konnte nicht auf die ausgewählte Datenbankdatei zugreifen."
          }
        }
      }
    },
    "KeeForge couldn't find the selected database file. It may have moved, been deleted, or the saved bookmark may need to be refreshed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge konnte die ausgewählte Datenbankdatei nicht finden. Sie wurde möglicherweise verschoben oder gelöscht, oder das gespeicherte Lesezeichen muss aktualisiert werden."
          }
        }
      }
    },
    "KeeForge couldn't find this cloud database. It may have moved, been deleted, or the account may need to reconnect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge konnte diese Cloud-Datenbank nicht finden. Sie wurde möglicherweise verschoben oder gelöscht, oder das Konto muss erneut verbunden werden."
