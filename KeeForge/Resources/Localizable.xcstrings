    "Get suggestions from every database at once, choose which ones AutoFill uses, and switch databases without leaving the AutoFill panel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalten Sie Vorschläge aus allen Datenbanken gleichzeitig, legen Sie fest, welche AutoFill verwendet, und wechseln Sie die Datenbank, ohne das AutoFill-Fenster zu verlassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reciba sugerencias de todas las bases de datos a la vez, decida cuáles utiliza Autorrelleno y cambie de base de datos sin salir del panel de Autorrelleno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenez des suggestions de toutes les bases de données à la fois, choisissez celles qu'utilise le Remplissage automatique, et changez de base de données sans quitter le panneau du Remplissage automatique."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时获取所有数据库的建议，选择自动填充要使用的数据库，并且无需离开自动填充面板即可切换数据库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時取得所有資料庫的建議，選擇自動填寫要使用的資料庫，並且無需離開自動填寫面板即可切換資料庫。"
          }
        }
      }
    },
