        }
      }
    },
    "Database contents, passwords, key files, and raw vault files are never included. Visible diagnostics may include app/device metadata and short file hash prefixes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenbankinhalte, Passwörter, Schlüsseldateien und unverarbeitete Tresordateien werden niemals einbezogen. Sichtbare Diagnosedaten können App- und Gerätemetadaten sowie kurze Präfixe von Datei-Hashes enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido de la base de datos, las contraseñas, los archivos de clave y los archivos de bóveda sin procesar nunca se incluyen. Los datos de diagnóstico visibles pueden incluir metadatos de la app y del dispositivo, así como prefijos cortos de hashes de archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu de la base de données, les mots de passe, les fichiers de clé et les fichiers de coffre bruts ne sont jamais inclus. Les diagnostics visibles peuvent inclure des métadonnées de l'app et de l'appareil, ainsi que de courts préfixes de hachage de fichier."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绝不会包含数据库内容、密码、密钥文件或原始保险库文件。可见的诊断信息可能包含应用/设备元数据及简短的文件哈希前缀。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絕不會包含資料庫內容、密碼、金鑰檔案或原始保險庫檔案。可見的診斷資訊可能包含 App/裝置中繼資料及簡短的檔案雜湊前綴。"
          }
        }
      }
    },
    "Database Details" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenbankdetails"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detalles de la base de datos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détails de la base de données"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库详细信息"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫詳細資訊"
          }
        }
      }
    },
    "Database Details now lists the last five backups KeeForge made on this device before saving or replacing a database, and each one can be exported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdetails zeigen jetzt die letzten fünf Sicherungskopien, die KeeForge auf diesem Gerät vor dem Speichern oder Ersetzen einer Datenbank angelegt hat, und jede davon lässt sich exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detalles de la base de datos ahora muestra las últimas cinco copias de seguridad que KeeForge hizo en este dispositivo antes de guardar o reemplazar una base de datos, y cada una se puede exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Détails de la base de données affichent désormais les cinq dernières sauvegardes que KeeForge a créées sur cet appareil avant d'enregistrer ou de remplacer une base de données, et chacune peut être exportée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“数据库详细信息”现在会列出 KeeForge 在此设备上保存或替换数据库前所做的最近五份备份，每份都可以导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「資料庫詳細資訊」現在會列出 KeeForge 在此裝置上儲存或取代資料庫前所做的最近五份備份，每份都可以匯出。"
          }
        }
      }
    },
