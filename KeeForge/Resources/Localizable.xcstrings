          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheinungsbild"
          }
        }
      }
    },
    "There isn't enough storage space in this cloud account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Cloud-Konto ist nicht genügend Speicherplatz vorhanden."
          }
        }
      }
    },
    "This account is disconnected. KeeForge keeps the cached copy until you remove the database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto ist getrennt. KeeForge behält die Cache-Kopie, bis Sie die Datenbank entfernen."
          }
        }
