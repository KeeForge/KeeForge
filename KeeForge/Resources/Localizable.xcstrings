    "Attach a photo when it helps explain an issue, and optionally add an email address if you'd like a reply." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie bei Bedarf ein Foto hinzu und geben Sie optional eine E-Mail-Adresse an, wenn Sie eine Antwort wünschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjunte una foto si ayuda a explicar un problema y, opcionalmente, añada una dirección de correo electrónico si desea una respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si nécessaire, joignez une photo et indiquez éventuellement une adresse e-mail si vous souhaitez une réponse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如有助于说明问题，可附加照片；如希望收到回复，可选填电子邮件地址。"
          }
        },
        "zh-Hant" : {
