    "Open an entry, tap Edit, and fill in its Tags field to gather related entries from any group." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie einen Eintrag, tippen Sie auf „Bearbeiten“ und füllen Sie dessen Feld „Tags“ aus, um zusammengehörige Einträge aus allen Gruppen zu sammeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra una entrada, toque «Editar» y rellene su campo «Etiquetas» para agrupar entradas relacionadas de cualquier grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez une entrée, appuyez sur « Modifier » et renseignez son champ « Tags » pour regrouper les entrées liées de tous les groupes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开条目，轻点“编辑”，填写其“标签”栏，即可将任意群组中的相关条目汇集起来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開項目，點一下「編輯」，填寫其「標籤」欄位，即可將任何群組中的相關項目彙整在一起。"
          }
        }
      }
    },
