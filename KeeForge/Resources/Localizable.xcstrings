    },
    "%@\n\nKeeForge opened the cached copy for now. Cloud sync needs attention before this database can be refreshed from its provider." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nKeeForge hat vorerst die Cache-Kopie geöffnet. Die Cloud-Synchronisierung erfordert Ihre Aufmerksamkeit, bevor diese Datenbank vom Anbieter aktualisiert werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nKeeForge ha abierto por ahora la copia almacenada en caché. La sincronización en la nube requiere su atención antes de poder actualizar esta base de datos desde su proveedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nKeeForge a ouvert la copie en cache pour l'instant. La synchronisation cloud nécessite votre attention avant que cette base de données puisse être actualisée depuis son fournisseur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nKeeForge 暂时打开了缓存副本。云同步需要处理后，此数据库才能从其提供商刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nKeeForge 暫時開啟了快取副本。需先處理雲端同步，此資料庫才能從其提供者重新整理。"
          }
        }
      }
    },
