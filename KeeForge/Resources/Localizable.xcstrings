    "Browse the earlier versions of an entry and restore one. The current contents are kept, so you can undo it. Thanks to @miquno." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blättern Sie durch die früheren Versionen eines Eintrags und stellen Sie eine davon wieder her. Der aktuelle Inhalt bleibt erhalten, sodass Sie den Schritt rückgängig machen können. Dank an @miquno."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore las versiones anteriores de una entrada y restaure una de ellas. El contenido actual se conserva, por lo que puede deshacer el cambio. Gracias a @miquno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourez les versions précédentes d'une entrée et restaurez-en une. Le contenu actuel est conservé, ce qui vous permet d'annuler l'opération. Merci à @miquno."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览条目的早期版本并恢复其中之一。当前内容会保留，因此可以撤销。感谢 @miquno。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽項目的較早版本並回復其中一個。目前內容會保留，因此可以還原此操作。感謝 @miquno。"
