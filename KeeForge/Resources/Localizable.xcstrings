          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données utilise un format de dérivation de clé que KeeForge ne prend pas encore en charge."
          }
        }
      }
    },
    "This database uses a protected-field format that KeeForge does not support yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank verwendet ein Format für geschützte Felder, das KeeForge noch nicht unterstützt."
