        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proceso de inicio de sesión en la nube se canceló antes de que KeeForge pudiera abrir la base de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La procédure de connexion au cloud a été annulée avant que KeeForge ne puisse ouvrir la base de données."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云登录流程在 KeeForge 打开数据库之前被取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雲端登入流程在 KeeForge 開啟資料庫之前已被取消。"
          }
        }
      }
    },
    "The current key file could not be read. Select it again or clear it, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle Schlüsseldatei konnte nicht gelesen werden. Wählen Sie sie erneut aus oder leeren Sie sie, und versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el archivo de clave actual. Selecciónelo de nuevo o bórrelo e inténtelo otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de clé actuel n'a pas pu être lu. Sélectionnez-le à nouveau ou effacez-le, puis réessayez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取当前的密钥文件。请重新选择或清除它，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取目前的金鑰檔案。請重新選取或清除它，然後再試一次。"
          }
        }
      }
    },
    "The database appears corrupted or incomplete." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank scheint beschädigt oder unvollständig zu sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos parece dañada o incompleta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données semble corrompue ou incomplète."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库似乎已损坏或不完整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫似乎已損毀或不完整。"
          }
        }
      }
    },
    "The database changed outside KeeForge. Merge both sets of changes, reload it, or save your draft as a sibling conflict copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank wurde außerhalb von KeeForge geändert. Führen Sie beide Änderungen zusammen, laden Sie sie neu oder sichern Sie Ihren Entwurf als Konfliktkopie neben der Datenbank."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos cambió fuera de KeeForge. Combine ambos conjuntos de cambios, vuelva a cargarla o guarde su borrador como una copia de conflicto junto a ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données a été modifiée en dehors de KeeForge. Fusionnez les deux ensembles de modifications, rechargez-la ou enregistrez votre brouillon en tant que copie de conflit adjacente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库已在 KeeForge 之外被更改。你可以合并两边的更改、重新加载，或将草稿保存为同级冲突副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫已在 KeeForge 之外被更改。你可以合併兩邊的變更、重新載入，或將草稿儲存為同層級的衝突副本。"
          }
        }
      }
    },
    "The database file changed since it was opened. Reload the database and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei wurde seit dem Öffnen geändert. Laden Sie die Datenbank neu und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de base de datos cambió desde que se abrió. Recargue la base de datos e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données a été modifié depuis son ouverture. Rechargez la base de données et réessayez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库文件在打开后发生了更改。请重新加载数据库后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫檔案在開啟後已變更。請重新載入資料庫後再試一次。"
          }
        }
      }
    },
    "The database file could not be found. Make sure it is still available in the Files app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei konnte nicht gefunden werden. Stellen Sie sicher, dass sie in der Dateien-App noch verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo encontrar el archivo de la base de datos. Asegúrese de que sigue disponible en la app Archivos."
