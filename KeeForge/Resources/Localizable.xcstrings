          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données ne peut pas être fusionnée pour le moment. Rechargez-la plutôt ou enregistrez vos modifications en tant que copie de conflit."
