    "This setup link expired. Open it again from the service to add the verification code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Einrichtungslink ist abgelaufen. Öffne ihn beim Dienst erneut, um den Bestätigungscode hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este enlace de configuración ha caducado. Ábrelo de nuevo en el servicio para añadir el código de verificación."
          }
        },
        "fr" : {
          "stringUnit" : {
