{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "\"%@\" already exists in this group." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist in dieser Gruppe bereits vorhanden."
          }
        }
      }
    },
    "\"%@\" contains %@. The group and its contents will be moved to the recycle bin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ enthält %2$@. Die Gruppe und ihr Inhalt werden in den Papierkorb verschoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" contains %2$@. The group and its contents will be moved to the recycle bin."
          }
        }
      }
    },
    "\"%@\" contains %@. The group and its contents will be removed immediately and cannot be restored from KeeForge." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ enthält %2$@. Die Gruppe und ihr Inhalt werden sofort gelöscht und können in KeeForge nicht wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" contains %2$@. The group and its contents will be removed immediately and cannot be restored from KeeForge."
          }
        }
      }
    },
    "“%@” is already in your database list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist bereits in Ihrer Datenbankliste enthalten."
          }
        }
      }
    },
    "“%@” is already used by a KeeForge-only database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird bereits von einer Datenbank verwendet, die nur in KeeForge verfügbar ist."
          }
        }
      }
    },
    "“%@” will be removed from KeeForge, including its cached copy and saved biometric key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird aus KeeForge entfernt, einschließlich der Cache-Kopie und des gespeicherten biometrischen Schlüssels."
          }
        }
      }
    },
    "%@\n\nKeeForge opened the cached copy for now. Cloud sync needs attention before this database can be refreshed from its provider." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nKeeForge hat vorerst die Cache-Kopie geöffnet. Die Cloud-Synchronisierung erfordert Ihre Aufmerksamkeit, bevor diese Datenbank vom Anbieter aktualisiert werden kann."
          }
        }
      }
    },
    "%@ - %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – %2$@"
