    "Rename a group, organize it with tags, choose an icon, add notes, and control whether its entries appear in Search and AutoFill." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benenne eine Gruppe um, organisiere sie mit Tags, wähle ein Symbol, füge Notizen hinzu und lege fest, ob ihre Einträge in der Suche und in AutoFill erscheinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el nombre de un grupo, organízalo con etiquetas, elige un icono, añade notas y controla si sus entradas aparecen en Buscar y Autorrelleno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renommez un groupe, organisez-le à l’aide de tags, choisissez une icône, ajoutez des notes et déterminez si ses entrées apparaissent dans la recherche et le Remplissage automatique."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重命名群组、用标签整理、选择图标、添加备注，并控制其中的条目是否出现在搜索和自动填充中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新命名群組、以標籤整理、選擇圖示、加入備註，並控制其中的項目是否顯示於搜尋和自動填寫。"
          }
        }
      }
    },
