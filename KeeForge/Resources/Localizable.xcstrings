    "KeeForge" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge"
          }
        }
      }
    },
    "KeeForge always locks on screen lock, screensaver, system sleep, and user switching. The stricter option also locks whenever another app becomes active." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge sperrt sich immer bei Bildschirmsperre, Bildschirmschoner, Ruhezustand des Systems und Benutzerwechsel. Die strengere Option sperrt außerdem, sobald eine andere App aktiv wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge siempre se bloquea con el bloqueo de pantalla, el salvapantallas, la suspensión del sistema y el cambio de usuario. La opción más estricta también se bloquea en cuanto otra aplicación se activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge se verrouille toujours lors du verrouillage de l'écran, de l'écran de veille, de la mise en veille du système et du changement d'utilisateur. L'option la plus stricte verrouille également dès qu'une autre app devient active."
          }
        }
      }
    },
    "KeeForge can now open older KeePass 3.1 vaults and databases protected with Twofish — and keeps their original encryption when you save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge kann jetzt ältere KeePass-3.1-Tresore und mit Twofish geschützte Datenbanken öffnen – und behält beim Speichern deren ursprüngliche Verschlüsselung bei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge ahora puede abrir bóvedas antiguas de KeePass 3.1 y bases de datos protegidas con Twofish, y conserva su cifrado original al guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge peut désormais ouvrir les anciens coffres KeePass 3.1 et les bases de données protégées avec Twofish — et conserve leur chiffrement d'origine lors de l'enregistrement."
          }
        }
      }
    },
    "KeeForge couldn't access the selected database file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge konnte nicht auf die ausgewählte Datenbankdatei zugreifen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge no pudo acceder al archivo de base de datos seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge n'a pas pu accéder au fichier de base de données sélectionné."
          }
        }
      }
    },
    "KeeForge couldn't find the selected database file. It may have moved, been deleted, or the saved bookmark may need to be refreshed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge konnte die ausgewählte Datenbankdatei nicht finden. Sie wurde möglicherweise verschoben oder gelöscht, oder das gespeicherte Lesezeichen muss aktualisiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge no pudo encontrar el archivo de base de datos seleccionado. Puede que se haya movido o eliminado, o que sea necesario actualizar el marcador guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge n'a pas pu trouver le fichier de base de données sélectionné. Il a peut-être été déplacé ou supprimé, ou le signet enregistré doit être actualisé."
          }
        }
      }
    },
    "KeeForge couldn't find this cloud database. It may have moved, been deleted, or the account may need to reconnect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge konnte diese Cloud-Datenbank nicht finden. Sie wurde möglicherweise verschoben oder gelöscht, oder das Konto muss erneut verbunden werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge no pudo encontrar esta base de datos en la nube. Puede que se haya movido o eliminado, o que sea necesario volver a conectar la cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge n'a pas pu trouver cette base de données cloud. Elle a peut-être été déplacée ou supprimée, ou le compte doit être reconnecté."
          }
        }
      }
    },
    "KeeForge couldn't finish reading this database file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge konnte das Lesen dieser Datenbankdatei nicht abschließen."
