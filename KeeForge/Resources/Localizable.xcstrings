        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données est introuvable. Vérifiez qu'il est toujours disponible dans l'app Fichiers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
