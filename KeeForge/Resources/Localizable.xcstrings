    "AutoFill can unlock with Touch ID on its own. KeeForge itself never unlocks automatically — use the Touch ID button on the unlock screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoFill kann sich selbst mit Touch ID entsperren. KeeForge selbst entsperrt sich nie automatisch – verwende dafür die Touch-ID-Taste im Entsperrbildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El autorrelleno puede desbloquearse por sí solo con Touch ID. KeeForge nunca se desbloquea automáticamente: usa el botón de Touch ID en la pantalla de desbloqueo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le remplissage automatique peut se déverrouiller seul avec Touch ID. KeeForge ne se déverrouille jamais automatiquement — utilisez le bouton Touch ID de l'écran de déverrouillage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动填充可以自行使用触控 ID 解锁。KeeForge 本身绝不会自动解锁——请使用解锁屏幕上的触控 ID 按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動填寫可以自行使用觸控 ID 解鎖。KeeForge 本身絕不會自動解鎖——請使用解鎖畫面上的觸控 ID 按鈕。"
          }
        }
      }
    },
