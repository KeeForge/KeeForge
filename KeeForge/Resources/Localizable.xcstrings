    "This password is weak. You can still change the master key, but a longer unique password is safer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Passwort ist schwach. Sie können den Master-Schlüssel trotzdem ändern, ein längeres, einzigartiges Passwort ist jedoch sicherer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta contraseña es débil. Aun así puede cambiar la clave maestra, pero una contraseña más larga y única es más segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot de passe est faible. Vous pouvez tout de même modifier la clé principale, mais un mot de passe plus long et unique est plus sûr."
          }
        }
      }
    },
    "This password is weak. You can still create the database, but a longer unique password is safer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Passwort ist schwach. Sie können die Datenbank trotzdem erstellen, ein längeres, einzigartiges Passwort ist jedoch sicherer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta contraseña es débil. Aun así puede crear la base de datos, pero una contraseña más larga y única es más segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot de passe est faible. Vous pouvez tout de même créer la base de données, mais un mot de passe plus long et unique est plus sûr."
          }
        }
      }
    },
    "This removes all suggestions from AutoFill. Suggestions return the next time you unlock each database that has AutoFill turned on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Vorschläge aus AutoFill entfernt. Die Vorschläge erscheinen wieder, sobald Sie eine Datenbank mit aktiviertem AutoFill das nächste Mal entsperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto quita todas las sugerencias del autorrelleno. Las sugerencias volverán a aparecer la próxima vez que desbloquee cada base de datos que tenga el autorrelleno activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime toutes les suggestions du remplissage automatique. Les suggestions réapparaissent la prochaine fois que vous déverrouillez chaque base de données pour laquelle le remplissage automatique est activé."
          }
        }
      }
    },
    "This server does not look like a WebDAV server (HTTP %lld). Check the server address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server scheint kein WebDAV-Server zu sein (HTTP %lld). Prüfen Sie die Serveradresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no parece ser un servidor WebDAV (HTTP %lld). Compruebe la dirección del servidor."
