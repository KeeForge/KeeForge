    "Hide a group and its entries stop appearing when you fill passwords, while staying fully visible when you browse the database in the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergen Sie eine Gruppe, und ihre Einträge erscheinen beim Ausfüllen von Passwörtern nicht mehr – beim Durchsuchen der Datenbank in der App bleiben sie vollständig sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculte un grupo y sus entradas dejarán de aparecer al rellenar contraseñas, aunque seguirán totalmente visibles al examinar la base de datos en la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquez un groupe : ses entrées cessent d'apparaître lors du remplissage des mots de passe, tout en restant entièrement visibles lorsque vous parcourez la base de données dans l'app."
          }
        }
      }
    },
