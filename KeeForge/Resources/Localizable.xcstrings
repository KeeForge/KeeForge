    "Choose an entry to view or edit its details." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie einen Eintrag aus, um seine Details anzuzeigen oder zu bearbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija una entrada para ver o editar sus detalles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une entrée pour afficher ou modifier ses détails."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个条目以查看或编辑其详细信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇項目以檢視或編輯其詳細資訊。"
          }
        }
      }
    },
    "Choose an entry's icon from the KeePass icon set or your database's custom icons — or download the website's own icon. Your choice is saved in the database, so it shows up everywhere. Thanks to @miquno." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Symbol eines Eintrags aus dem KeePass-Symbolsatz oder den eigenen Symbolen deiner Datenbank – oder lade das Symbol der Website herunter. Deine Wahl wird in der Datenbank gespeichert und erscheint so überall. Dank an @miquno."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el icono de una entrada entre el conjunto de iconos de KeePass o los iconos personalizados de tu base de datos, o descarga el icono del sitio web. Tu elección se guarda en la base de datos, así que aparece en todas partes. Gracias a @miquno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l'icône d'une entrée parmi le jeu d'icônes KeePass ou les icônes personnalisées de votre base de données – ou téléchargez l'icône du site web. Votre choix est enregistré dans la base de données et apparaît donc partout. Merci à @miquno."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可从 KeePass 图标集或数据库的自定图标中选择条目的图标，也可以下载网站自己的图标。您的选择会保存在数据库中，因此会在各处显示。感谢 @miquno。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可從 KeePass 圖示集或資料庫的自訂圖示中選擇項目的圖示，也可以下載網站本身的圖示。您的選擇會儲存在資料庫中，因此會在各處顯示。感謝 @miquno。"
          }
        }
      }
    },
