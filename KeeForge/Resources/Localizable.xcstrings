    "Contact Support" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support kontaktieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contactar con soporte"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacter le support"
          }
        },
