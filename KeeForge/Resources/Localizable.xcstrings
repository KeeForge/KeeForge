    "Could not establish a secure connection because the server's certificate is invalid, expired, or untrusted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte keine sichere Verbindung hergestellt werden, da das Zertifikat des Servers ungültig, abgelaufen oder nicht vertrauenswürdig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo establecer una conexión segura porque el certificado del servidor no es válido, ha caducado o no es de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'établir une connexion sécurisée, car le certificat du serveur est invalide, expiré ou non approuvé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法建立安全连接：服务器证书无效、已过期或不受信任。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法建立安全連線：伺服器憑證無效、已過期或不受信任。"
          }
        }
      }
    },
    "Could not establish a secure connection. The server requires a client certificate, which KeeForge does not support." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte keine sichere Verbindung hergestellt werden. Der Server verlangt ein Client-Zertifikat, das von KeeForge nicht unterstützt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo establecer una conexión segura. El servidor requiere un certificado de cliente, que KeeForge no admite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'établir une connexion sécurisée. Le serveur exige un certificat client, ce que KeeForge ne prend pas en charge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法建立安全连接。服务器要求客户端证书，而 KeeForge 不支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法建立安全連線。伺服器要求用戶端憑證，KeeForge 不支援此功能。"
          }
        }
      }
    },
    "Could not establish a secure connection. The server's TLS settings are likely outdated or incompatible with this device. Ask the server operator to enable TLS 1.3, or TLS 1.2 with modern (ECDHE + AES-GCM) cipher suites." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte keine sichere Verbindung hergestellt werden. Die TLS-Einstellungen des Servers sind vermutlich veraltet oder mit diesem Gerät nicht kompatibel. Bitten Sie den Serverbetreiber, TLS 1.3 oder TLS 1.2 mit modernen Cipher-Suiten (ECDHE + AES-GCM) zu aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo establecer una conexión segura. Es probable que la configuración TLS del servidor esté desactualizada o no sea compatible con este dispositivo. Pida al operador del servidor que habilite TLS 1.3, o TLS 1.2 con conjuntos de cifrado modernos (ECDHE + AES-GCM)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'établir une connexion sécurisée. Les réglages TLS du serveur sont probablement obsolètes ou incompatibles avec cet appareil. Demandez à l'administrateur du serveur d'activer TLS 1.3, ou TLS 1.2 avec des suites de chiffrement modernes (ECDHE + AES-GCM)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法建立安全连接。服务器的 TLS 设置可能已过时或与此设备不兼容。请要求服务器管理员启用 TLS 1.3，或启用采用现代加密套件（ECDHE + AES-GCM）的 TLS 1.2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法建立安全連線。伺服器的 TLS 設定可能已過時或與此裝置不相容。請要求伺服器管理員啟用 TLS 1.3，或啟用採用新式加密套件（ECDHE + AES-GCM）的 TLS 1.2。"
          }
        }
      }
    },
    "Could not establish a secure connection. This device requires an https:// server address." : {
