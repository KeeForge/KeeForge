          }
        }
      }
    },
    "This database has pending AutoFill changes. Let them finish syncing, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank hat ausstehende AutoFill-Änderungen. Lassen Sie sie zuerst fertig synchronisieren und versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
