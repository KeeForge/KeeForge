    "KeeForge couldn't recognize this file as a valid KDBX database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge konnte diese Datei nicht als gültige KDBX-Datenbank erkennen."
          }
        },
        "es" : {
          "stringUnit" : {
