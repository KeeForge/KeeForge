    "If AutoFill is off, KeeForge now lets you know and helps you turn it on right from your database list or Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn AutoFill deaktiviert ist, weist KeeForge Sie jetzt darauf hin und hilft Ihnen, es direkt über die Datenbankliste oder die Einstellungen zu aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si Autorrelleno está desactivado, KeeForge ahora se lo indica y le ayuda a activarlo directamente desde la lista de bases de datos o los ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le Remplissage automatique est désactivé, KeeForge vous en informe désormais et vous aide à l'activer directement depuis votre liste de bases de données ou les réglages."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果自动填充处于关闭状态，KeeForge 现在会提醒您，并帮助您直接从数据库列表或设置中开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果自動填寫已關閉，KeeForge 現在會提醒您，並協助您直接從資料庫清單或設定中開啟。"
          }
        }
      }
    },
