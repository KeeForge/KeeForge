          }
        }
      }
    },
    "KeeForge couldn't submit the feedback right now. Please try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge konnte das Feedback derzeit nicht senden. Versuchen Sie es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge no pudo enviar los comentarios en este momento. Inténtelo de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge n'a pas pu envoyer les commentaires pour le moment. Veuillez réessayer plus tard."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge 目前无法提交反馈。请稍后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge 目前無法送出意見回饋。請稍後再試。"
          }
        }
      }
    },
    "KeeForge creates KDBX 4 databases encrypted with %@ and Argon2id key derivation (%@). Stronger settings take longer to unlock and may exceed AutoFill's memory limit on some devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge erstellt KDBX-4-Datenbanken, die mit %1$@ verschlüsselt sind und Argon2id zur Schlüsselableitung verwenden (%2$@). Stärkere Einstellungen verlängern das Entsperren und können auf manchen Geräten das Speicherlimit von AutoFill überschreiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge crea bases de datos KDBX 4 cifradas con %1$@ y derivación de claves Argon2id (%2$@). Los ajustes más fuertes tardan más en desbloquear y pueden superar el límite de memoria del autorrelleno en algunos dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge crée des bases de données KDBX 4 chiffrées avec %1$@ et une dérivation de clé Argon2id (%2$@). Des réglages plus forts allongent le déverrouillage et peuvent dépasser la limite de mémoire du remplissage automatique sur certains appareils."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge 创建使用 %1$@ 加密和 Argon2id 密钥派生（%2$@）的 KDBX 4 数据库。更强的设置会延长解锁时间，并可能在部分设备上超出自动填充的内存限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge 會建立使用 %1$@ 加密和 Argon2id 金鑰衍生（%2$@）的 KDBX 4 資料庫。更強的設定會延長解鎖時間，並可能在部分裝置上超出自動填寫的記憶體限制。"
          }
        }
      }
    },
    "KeeForge creates KDBX 4 databases encrypted with %@ and Argon2id key derivation (%@). Stronger settings take longer to unlock." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge erstellt KDBX-4-Datenbanken, die mit %1$@ verschlüsselt sind und Argon2id zur Schlüsselableitung verwenden (%2$@). Stärkere Einstellungen verlängern das Entsperren."
          }
        },
