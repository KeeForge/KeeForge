        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge 尚未啟用為自動填寫提供者。請在「一般」>「自動填寫與密碼」中開啟，即可在 Safari 和其他 App 中填寫密碼。"
          }
        }
      }
    },
    "KeeForge keeps the last five backups it made before saving or replacing this database on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge behält die letzten fünf Sicherungskopien, die es vor dem Speichern oder Ersetzen dieser Datenbank auf diesem Gerät angelegt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge conserva las últimas cinco copias de seguridad que creó antes de guardar o sustituir esta base de datos en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge conserve les cinq dernières sauvegardes créées avant d'enregistrer ou de remplacer cette base de données sur cet appareil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge 会在此设备上保留保存或替换此数据库前所做的最近五份备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge 會在此裝置上保留儲存或取代此資料庫前所做的最近五份備份。"
          }
        }
      }
    },
    "KeeForge needs refreshed cloud access before it can continue with this database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
