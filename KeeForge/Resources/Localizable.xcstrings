    "See your database's format, file size, last update, encryption, key-derivation settings, and compression without unlocking it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehen Sie Format, Dateigröße, letzte Änderung, Verschlüsselung, Einstellungen zur Schlüsselableitung und Komprimierung Ihrer Datenbank, ohne sie zu entsperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vea el formato, el tamaño del archivo, la última actualización, el cifrado, los ajustes de derivación de claves y la compresión de su base de datos sin desbloquearla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez le format, la taille du fichier, la dernière modification, le chiffrement, les paramètres de dérivation de clé et la compression de votre base de données, sans la déverrouiller."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需解锁即可查看数据库的格式、文件大小、最近更新时间、加密方式、密钥派生设置和压缩方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無需解鎖即可查看資料庫的格式、檔案大小、最近更新時間、加密方式、金鑰衍生設定和壓縮方式。"
          }
        }
      }
    },
