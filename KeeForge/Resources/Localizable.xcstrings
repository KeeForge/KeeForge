    "Search results and the tag browser now show the folder each entry lives in, so similarly named entries are easier to tell apart." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchergebnisse und der Tag-Browser zeigen jetzt den Ordner jedes Eintrags an, sodass sich ähnlich benannte Einträge leichter unterscheiden lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados de búsqueda y el explorador de etiquetas ahora muestran la carpeta de cada entrada, para que sea más fácil distinguir las entradas con nombres similares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats de recherche et le navigateur de tags affichent désormais le dossier de chaque entrée, ce qui permet de distinguer plus facilement les entrées portant des noms similaires."
          }
        }
      }
    },
