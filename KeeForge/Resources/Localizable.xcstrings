            "value" : "Gruppen vor AutoFill verbergen"
          }
        }
      }
    },
    "Hide master password" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Master-Passwort ausblenden"
          }
        }
      }
    },
    "HMAC verification failed — file corrupted or wrong password" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HMAC-Überprüfung fehlgeschlagen — Datei beschädigt oder falsches Passwort"
          }
        }
      }
    },
    "HTTP sends your WebDAV username, password, and database traffic without encryption. Only use it on a local network you trust." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP überträgt Ihren WebDAV-Benutzernamen, Ihr Passwort und den Datenbankverkehr unverschlüsselt. Verwenden Sie es nur in einem lokalen Netzwerk, dem Sie vertrauen."
          }
        }
      }
    },
    "iCloud may sync changes from another device while you're editing. We recommend keeping all writes on one device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud synchronisiert möglicherweise Änderungen von einem anderen Gerät, während Sie die Datenbank bearbeiten. Es wird empfohlen, alle Schreibvorgänge auf ein Gerät zu beschränken."
          }
        }
      }
    },
    "Identity" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identität"
          }
        }
      }
    },
    "If AutoFill is off, KeeForge now lets you know and helps you turn it on right from your database list or Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn AutoFill deaktiviert ist, weist KeeForge Sie jetzt darauf hin und hilft Ihnen, es direkt über die Datenbankliste oder die Einstellungen zu aktivieren."
          }
        }
      }
    },
