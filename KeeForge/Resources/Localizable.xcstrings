    "After you click Create, choose the %@ folder for the encrypted .kdbx database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdem Sie auf „Erstellen“ geklickt haben, wählen Sie den Ordner „%@“ für die verschlüsselte .kdbx-Datenbank."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de hacer clic en «Crear», elija la carpeta «%@» para la base de datos .kdbx cifrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir cliqué sur « Créer », choisissez le dossier « %@ » pour la base de données .kdbx chiffrée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
