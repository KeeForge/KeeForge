    "Use KeeForge with a trusted local WebDAV server even when it doesn't support HTTPS. The option lives under Advanced and includes a clear security warning." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie KeeForge mit einem vertrauenswürdigen lokalen WebDAV-Server, auch wenn dieser HTTPS nicht unterstützt. Die Option befindet sich unter „Erweitert“ und enthält einen deutlichen Sicherheitshinweis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use KeeForge con un servidor WebDAV local de confianza incluso si no admite HTTPS. La opción se encuentra en «Avanzado» e incluye una advertencia de seguridad clara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez KeeForge avec un serveur WebDAV local de confiance même s'il ne prend pas en charge HTTPS. L'option se trouve dans Avancé et comprend un avertissement de sécurité explicite."
          }
        }
