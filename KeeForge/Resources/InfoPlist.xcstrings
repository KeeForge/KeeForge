        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge 使用 Face ID 快速解鎖你的密碼資料庫。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge verwendet Ihr lokales Netzwerk, um eine Verbindung zu den von Ihnen hinzugefügten WebDAV-Servern herzustellen."
