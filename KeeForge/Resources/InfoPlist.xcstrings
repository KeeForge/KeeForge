    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge verwendet die Kamera, um QR-Codes für Bestätigungscodes zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge uses the camera to scan verification-code QR codes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge usa la cámara para escanear códigos QR de códigos de verificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge utilise la caméra pour scanner les codes QR de codes de vérification."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge verwendet Face ID, um Ihre Passwortdatenbank schnell zu entsperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge uses Face ID to quickly unlock your password database."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge usa Face ID para desbloquear rápidamente su base de datos de contraseñas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge utilise Face ID pour déverrouiller rapidement votre base de données de mots de passe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeeForge 使用 Face ID 快速解锁你的密码数据库。"
