<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.keevault.shared</string>
	</array>
	<!-- MSAL's macOS token cache defaults to the com.microsoft.identity.universalstorage
	     keychain group (MSIDKeychainTokenCache / MSIDMacKeychainTokenCache), unlike the
	     iOS com.microsoft.adalcache group. MSAL verifies this entitlement by suffix
	     match before enabling the cache, so silent OneDrive token refresh across
	     relaunch depends on this entry. Keep the shared keychain group first. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.keevault.sharedkeychain</string>
		<string>$(AppIdentifierPrefix)com.microsoft.identity.universalstorage</string>
	</array>
</dict>
</plist>
