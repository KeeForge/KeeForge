<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.keevault.shared</string>
	</array>
	<!-- Items stored without an explicit kSecAttrAccessGroup land in the FIRST
	     group listed, so com.keevault.sharedkeychain must stay first if a second
	     group is ever added back.

	     MSAL's macOS token cache group (com.microsoft.identity.universalstorage,
	     unlike the iOS com.microsoft.adalcache) is deliberately NOT here: macOS
	     ships WebDAV only, so nothing authenticates through MSAL and nothing
	     writes to that group. Re-enabling OneDrive on macOS means adding it back
	     AND regenerating the hand-made Developer ID profiles, which embed the
	     entitlements — MSAL checks for it by suffix match before it will enable
	     the cache, and silent token refresh across relaunch does not work
	     without it. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.keevault.sharedkeychain</string>
	</array>
</dict>
</plist>
