<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>Dropbox OAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>db-$(DROPBOX_APP_KEY)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>OneDrive OAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>msauth.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>OTP Authentication</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>otpauth</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>KeePass Database</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.keevault.kdbx</string>
				<string>com.keepassium.kdbx</string>
				<string>com.jflan.MiniKeePass.kdbx</string>
				<string>com.kptouch.kdbx</string>
				<string>com.markmcguill.strongbox.kdbx</string>
				<string>com.maxep.mikee.kdbx</string>
			</array>
		</dict>
	</array>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CloudKeychainAccessGroup</key>
	<string>$(CLOUD_KEYCHAIN_ACCESS_GROUP)</string>
	<key>DropboxAppKey</key>
	<string>$(DROPBOX_APP_KEY)</string>
	<key>OneDriveClientID</key>
	<string>$(ONEDRIVE_CLIENT_ID)</string>
	<key>OneDriveRedirectURI</key>
	<string>msauth.$(PRODUCT_BUNDLE_IDENTIFIER)://auth</string>
	<key>GITCommitHash</key>
	<string>$(GIT_COMMIT_HASH)</string>
	<!-- Sparkle, direct-download channel only. Both values come from build
	     settings that are empty for the Mac App Store target, which does not
	     link Sparkle at all; keeping one Info.plist avoids a third copy of
	     this file to keep in sync. SUPublicEDKey is the public half of the
	     EdDSA pair — the private key never enters the repo or CI logs. -->
	<key>SUFeedURL</key>
	<string>$(SPARKLE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_ED_KEY)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>KeeForge uses your local network to connect to WebDAV servers you add.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!--
		Same rationale as KeeForge/Info.plist: user-specified WebDAV servers
		often lack ATS-approved forward-secrecy ciphers, and ATS has no
		per-domain exception for user-entered hosts. NSAllowsLocalNetworking
		must not be re-added alongside NSAllowsArbitraryLoads (it would make
		the system ignore the arbitrary-loads key).
		-->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<!--
		First-party hosts the app controls are modern HTTPS, so ATS stays
		enforced for them via per-domain exceptions. Listing a domain here
		re-applies ATS to it (forward secrecy, TLS 1.2, no cleartext HTTP)
		while everything unlisted still falls under NSAllowsArbitraryLoads
		above, so user-entered WebDAV hosts are unaffected.
		-->
		<key>NSExceptionDomains</key>
		<dict>
			<key>duckduckgo.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>keeforge.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>dropbox.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>dropboxapi.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>microsoft.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>microsoftonline.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>SKIncludeConsumableInAppPurchaseHistory</key>
	<true/>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>KeePass Database (kdbx)</string>
			<key>UTTypeIdentifier</key>
			<string>com.keevault.kdbx</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>kdbx</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.keevault.kdbx</string>
			</array>
			<key>UTTypeDescription</key>
			<string>KeePass Database (kdbx)</string>
			<key>UTTypeIdentifier</key>
			<string>com.keepassium.kdbx</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>kdbx</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.keevault.kdbx</string>
			</array>
			<key>UTTypeDescription</key>
			<string>KeePass Database (kdbx)</string>
			<key>UTTypeIdentifier</key>
			<string>com.jflan.MiniKeePass.kdbx</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>kdbx</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.keevault.kdbx</string>
			</array>
			<key>UTTypeDescription</key>
			<string>KeePass Database (kdbx)</string>
			<key>UTTypeIdentifier</key>
			<string>com.kptouch.kdbx</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>kdbx</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.keevault.kdbx</string>
			</array>
			<key>UTTypeDescription</key>
			<string>KeePass Database (kdbx)</string>
			<key>UTTypeIdentifier</key>
			<string>com.markmcguill.strongbox.kdbx</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>kdbx</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.keevault.kdbx</string>
			</array>
			<key>UTTypeDescription</key>
			<string>KeePass Database (kdbx)</string>
			<key>UTTypeIdentifier</key>
			<string>com.maxep.mikee.kdbx</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>kdbx</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
