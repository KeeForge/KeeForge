    },
    "This adds “%@” to “%@” so AutoFill suggests the entry on that website next time. Check the address before adding it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird „%1$@“ zu „%2$@“ hinzugefügt, damit AutoFill den Eintrag künftig auf dieser Website vorschlägt. Prüfe die Adresse, bevor du sie hinzufügst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This adds “%1$@” to “%2$@” so AutoFill suggests the entry on that website next time. Check the address before adding it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto añade «%1$@» a «%2$@» para que Autorrelleno sugiera la entrada en ese sitio web la próxima vez. Comprueba la dirección antes de añadirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci ajoute « %1$@ » à « %2$@ » afin que le Remplissage automatique propose l’entrée sur ce site web la prochaine fois. Vérifiez l’adresse avant de l’ajouter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” verrà aggiunto a “%2$@”, così l'inserimento automatico suggerirà la voce su quel sito web la prossima volta. Controlla l'indirizzo prima di aggiungerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%2$@」に「%1$@」を追加し、次回からその Web サイトで自動入力がこのエントリを候補に表示するようにします。追加する前にアドレスを確認してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» будет добавлен в «%2$@», чтобы в следующий раз автозаполнение предлагало эту запись на этом сайте. Проверьте адрес перед добавлением."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会将“%1$@”添加到“%2$@”，以便下次在该网站上自动填充时推荐此条目。添加前请核对地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會將「%1$@」加入「%2$@」，以便下次在該網站上自動填寫時建議此項目。加入前請核對網址。"
          }
        }
      }
    },
    "This database changed in the cloud. Reload before saving again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank wurde in der Cloud geändert. Lade sie vor dem erneuten Sichern neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos cambió en la nube. Vuelve a cargarla antes de guardar de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données a été modifiée dans le cloud. Rechargez-la avant de l'enregistrer à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo database è cambiato nel cloud. Ricaricalo prima di salvare di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデータベースはクラウド上で変更されています。もう一度保存する前に再読み込みしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта база данных изменилась в облаке. Перезагрузите её перед повторным сохранением."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
