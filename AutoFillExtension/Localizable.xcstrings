    "This database needs a YubiKey, which AutoFill can't use yet. Open it in the KeeForge app instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank benötigt einen YubiKey, den das automatische Ausfüllen noch nicht verwenden kann. Öffne sie stattdessen in der KeeForge-App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos necesita una YubiKey, que Autorrelleno aún no puede usar. Ábrela en la app KeeForge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données nécessite une YubiKey, que le remplissage automatique ne peut pas encore utiliser. Ouvrez-la plutôt dans l’app KeeForge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo database richiede una YubiKey, che l'inserimento automatico non può ancora usare. Aprilo invece nell'app KeeForge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデータベースには YubiKey が必要ですが、自動入力ではまだ使用できません。代わりに KeeForge App で開いてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этой базе данных нужен YubiKey, который автозаполнение пока не может использовать. Откройте её в приложении KeeForge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此数据库需要 YubiKey，而自动填充暂不支持。请改为在 KeeForge App 中打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此資料庫需要 YubiKey，而自動填寫暫不支援。請改在 KeeForge App 中開啟。"
          }
        }
      }
    },
    "This database needs about %@ of memory to unlock, more than the %@ AutoFill is allowed to use. Open the entry in the KeeForge app, or lower the database's Argon2 memory setting in a desktop KeePass app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank benötigt zum Entsperren etwa %1$@ Arbeitsspeicher — mehr als die %2$@, die AutoFill verwenden darf. Öffne den Eintrag in der KeeForge-App oder verringere die Argon2-Speichereinstellung der Datenbank in einer KeePass-App für den Computer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This database needs about %1$@ of memory to unlock, more than the %2$@ AutoFill is allowed to use. Open the entry in the KeeForge app, or lower the database's Argon2 memory setting in a desktop KeePass app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos necesita unos %1$@ de memoria para desbloquearse, más de los %2$@ que el autorrelleno puede usar. Abre la entrada en la app KeeForge, o reduce el ajuste de memoria Argon2 de la base de datos en una app KeePass de escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données a besoin d’environ %1$@ de mémoire pour être déverrouillée, soit plus que les %2$@ autorisés pour AutoFill. Ouvrez l’entrée dans l’app KeeForge, ou réduisez le réglage de mémoire Argon2 de la base de données dans une app KeePass pour ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per sbloccare questo database servono circa %1$@ di memoria, più dei %2$@ che l'inserimento automatico può usare. Apri la voce nell'app KeeForge oppure riduci l'impostazione della memoria Argon2 del database in un'app KeePass per computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデータベースのロック解除には約 %1$@ のメモリが必要で、自動入力に許可された %2$@ を超えています。KeeForge App でエントリを開くか、デスクトップ版の KeePass App でデータベースの Argon2 のメモリ設定を下げてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для разблокировки этой базе данных нужно около %1$@ памяти — больше, чем %2$@, доступные автозаполнению. Откройте запись в приложении KeeForge или уменьшите параметр памяти Argon2 базы данных в настольном приложении KeePass."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解锁此数据库大约需要 %1$@ 内存，超出了自动填充可使用的 %2$@ 上限。请在 KeeForge App 中打开该条目，或在桌面版 KeePass 应用中调低数据库的 Argon2 内存设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解鎖此資料庫大約需要 %1$@ 記憶體，超出了自動填寫可使用的 %2$@ 上限。請在 KeeForge App 中開啟該項目，或在桌面版 KeePass App 中調低資料庫的 Argon2 記憶體設定。"
          }
        }
      }
    },
    "This database uses an older KeePass format that KeeForge does not support yet." : {
      "localizations" : {
