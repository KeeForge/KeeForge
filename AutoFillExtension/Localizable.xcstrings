    "Export a full encrypted copy of your unsaved changes before closing this session. Open it with the master key used by this unlocked session. Exporting keeps your edits here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiere vor dem Schließen dieser Sitzung eine vollständige verschlüsselte Kopie deiner ungesicherten Änderungen. Öffne sie mit dem Hauptschlüssel dieser entsperrten Sitzung. Deine Änderungen bleiben beim Exportieren hier erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export a full encrypted copy of your unsaved changes before closing this session. Open it with the master key used by this unlocked session. Exporting keeps your edits here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de cerrar esta sesión, exporta una copia cifrada completa de los cambios sin guardar. Ábrela con la clave maestra de esta sesión desbloqueada. Exportar conserva tus ediciones aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de fermer cette session, exportez une copie chiffrée complète de vos modifications non enregistrées. Ouvrez-la avec la clé principale de cette session déverrouillée. L'exportation conserve vos modifications ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di chiudere questa sessione, esporta una copia cifrata completa delle modifiche non salvate. Aprila con la chiave principale di questa sessione sbloccata. L'esportazione conserva qui le modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションを閉じる前に、未保存の変更を含む完全な暗号化コピーを書き出してください。このロック解除済みセッションのマスターキーで開いてください。書き出しても編集内容はここに残ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед закрытием сеанса экспортируйте полную зашифрованную копию несохранённых изменений. Открывайте её мастер-ключом этого разблокированного сеанса. Экспорт сохраняет ваши правки здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭此会话前，请导出包含未存储更改的完整加密副本。请使用此已解锁会话的主密钥打开。导出会保留此处的编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉此工作階段前，請輸出包含尚未儲存變更的完整加密副本。請使用此已解鎖工作階段的主密鑰開啟。輸出會保留此處的編輯。"
          }
        }
      }
    },
