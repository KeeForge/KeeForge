    "Each source is a full encrypted database snapshot. Open exported files with their original master key. Exporting does not discard the source." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Quelle ist eine vollständige verschlüsselte Momentaufnahme der Datenbank. Verwende zum Öffnen des Exports ihren ursprünglichen Hauptschlüssel. Beim Exportieren bleibt die Quelle erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each source is a full encrypted database snapshot. Open exported files with their original master key. Exporting does not discard the source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada origen es una instantánea cifrada completa de la base de datos. Usa su clave maestra original para abrir la exportación. Exportar no descarta el origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque source est un instantané chiffré complet de la base de données. Utilisez sa clé principale d'origine pour ouvrir l'export. L'exportation ne supprime pas la source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni origine è un'istantanea cifrata completa del database. Usa la chiave principale originale per aprire l'esportazione. L'esportazione non elimina l'origine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ソースはデータベース全体の暗号化スナップショットです。書き出したファイルは元のマスターキーで開いてください。書き出してもソースは破棄されません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый источник — полный зашифрованный снимок базы данных. Используйте исходный мастер-ключ для открытия экспорта. Экспорт не удаляет источник."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个来源都是数据库的完整加密快照。请使用原始主密钥打开导出的文件。导出不会丢弃来源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個來源都是資料庫的完整加密快照。請使用原始主密鑰打開輸出的檔案。輸出不會捨棄來源。"
          }
        }
      }
    },
    "Encryption failed" : {
      "localizations" : {
