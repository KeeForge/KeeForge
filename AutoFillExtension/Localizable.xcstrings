    "This database's icons are stored in a form KeeForge cannot add to without risking the ones already there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Symbole dieser Datenbank liegen in einer Form vor, zu der KeeForge nichts hinzufügen kann, ohne die bereits vorhandenen zu gefährden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los iconos de esta base de datos están guardados en un formato al que KeeForge no puede añadir nada sin poner en riesgo los que ya contiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les icônes de cette base de données sont enregistrées sous une forme à laquelle KeeForge ne peut rien ajouter sans risquer celles qui s’y trouvent déjà."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le icone di questo database sono archiviate in una forma a cui KeeForge non può aggiungerne altre senza mettere a rischio quelle già presenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデータベースのアイコンは、既存のアイコンを損なわずに新しいアイコンを追加できない形式で保存されています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значки этой базы данных хранятся в таком виде, что KeeForge не может добавить к ним новые, не рискуя уже существующими."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此数据库的图标存储形式特殊，KeeForge 无法在不危及现有图标的情况下添加新图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此資料庫的圖示儲存形式特殊，KeeForge 無法在不危及現有圖示的情況下新增圖示。"
          }
        }
      }
    },
    "This database’s icons cannot be changed safely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Symbole dieser Datenbank können nicht sicher geändert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This database’s icons cannot be changed safely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los iconos de esta base de datos no se pueden modificar de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les icônes de cette base de données ne peuvent pas être modifiées sans risque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le icone di questo database non possono essere modificate in modo sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
