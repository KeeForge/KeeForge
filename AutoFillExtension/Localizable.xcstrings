        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo de clave usa una versión que KeeForge no admite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier de clé utilise une version que KeeForge ne prend pas en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo file chiave usa una versione che KeeForge non supporta."
          }
        },
        "ja" : {
