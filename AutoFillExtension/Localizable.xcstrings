    "An earlier version of the entry “%1$@” contains an unsupported character (%2$@) in “%3$@”, so the database can’t be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine frühere Version des Eintrags „%1$@“ enthält in „%3$@“ ein nicht unterstütztes Zeichen (%2$@), daher kann die Datenbank nicht gespeichert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An earlier version of the entry “%1$@” contains an unsupported character (%2$@) in “%3$@”, so the database can’t be saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una versión anterior de la entrada «%1$@» contiene un carácter no compatible (%2$@) en «%3$@», por lo que no se puede guardar la base de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une version précédente de l'entrée « %1$@ » contient un caractère non pris en charge (%2$@) dans « %3$@ » : la base de données ne peut donc pas être enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una versione precedente della voce “%1$@” contiene un carattere non supportato (%2$@) in “%3$@”, quindi non è possibile salvare il database."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エントリ「%1$@」の以前のバージョンの「%3$@」にサポートされていない文字（%2$@）が含まれているため、データベースを保存できません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предыдущая версия записи «%1$@» содержит неподдерживаемый символ (%2$@) в «%3$@», поэтому базу данных нельзя сохранить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条目“%1$@”的较早的版本在“%3$@”中包含不支持的字符（%2$@），因此无法保存数据库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目「%1$@」的較早的版本在「%3$@」中包含不支援的字元（%2$@），因此無法儲存資料庫。"
          }
        }
      }
    },
