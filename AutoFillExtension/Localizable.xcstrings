    "Caution: “%@” isn’t related to any website saved in this entry. If it’s a lookalike site, adding it lets AutoFill offer this password there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtung: „%@“ hat nichts mit den in diesem Eintrag gespeicherten Websites zu tun. Handelt es sich um eine nachgeahmte Website, würde AutoFill dieses Passwort nach dem Hinzufügen dort anbieten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atención: «%@» no está relacionado con ningún sitio web guardado en esta entrada. Si es un sitio que imita a otro, al añadirlo Autorrelleno ofrecerá allí esta contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attention : « %@ » n’a aucun rapport avec les sites web enregistrés dans cette entrée. S’il s’agit d’un site d’imitation, l’ajouter permettrait au Remplissage automatique d’y proposer ce mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attenzione: “%@” non è collegato a nessun sito web salvato in questa voce. Se è un sito che ne imita un altro, aggiungendolo l'inserimento automatico vi proporrà questa password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：「%@」は、このエントリに保存されているどの Web サイトとも関係がありません。偽装サイトの場合、追加するとそのサイトで自動入力がこのパスワードを提示するようになります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимание: «%@» не связан ни с одним сайтом, сохранённым в этой записи. Если это поддельный сайт, после добавления автозаполнение будет предлагать там этот пароль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：“%@”与此条目中保存的任何网站都无关。如果这是仿冒网站，添加后自动填充会在该网站上提供此密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：「%@」與此項目中儲存的任何網站都無關。如果這是仿冒網站，加入後自動填寫會在該網站上提供此密碼。"
          }
        }
      }
    },
