      }
    },
    "The cloud service is busy right now. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cloud-Dienst ist gerade ausgelastet. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio en la nube está ocupado en este momento. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service cloud est occupé actuellement. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio cloud è occupato in questo momento. Riprova tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドサービスが混み合っています。しばらくしてからもう一度お試しください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Облачная служба сейчас занята. Повторите попытку через мгновение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云服务当前正忙。请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雲端服務目前忙碌。請稍後再試。"
          }
        }
      }
    },
    "The cloud service is temporarily unavailable. Try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cloud-Dienst ist vorübergehend nicht verfügbar. Versuche es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio en la nube no está disponible temporalmente. Inténtalo de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service cloud est temporairement indisponible. Réessayez plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
