    "Authenticate the current file and merge it with your unsaved changes. Choose Save separately to write the result." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifiziere die aktuelle Datei und führe sie mit deinen ungesicherten Änderungen zusammen. Wähle danach Sichern, um das Ergebnis zu schreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticate the current file and merge it with your unsaved changes. Choose Save separately to write the result."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentica el archivo actual y combínalo con tus cambios sin guardar. Elige Guardar por separado para escribir el resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifiez le fichier actuel et fusionnez-le avec vos modifications non enregistrées. Choisissez ensuite Enregistrer pour écrire le résultat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentica il file attuale e uniscilo alle modifiche non salvate. Scegli Salva separatamente per scrivere il risultato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のファイルを認証して未保存の変更と統合します。結果を書き込むには、別途「保存」を選んでください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте текущий файл и объедините его с несохранёнными правками. Отдельно выберите «Сохранить», чтобы записать результат."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证当前文件并将其与你未存储的更改合并。请另行选择“存储”来写入结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證目前檔案並將其與你尚未儲存的更改合併。請另外選擇「儲存」來寫入結果。"
          }
        }
      }
    },
