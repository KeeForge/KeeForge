          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会将原始请求 URL 添加到所选凭据。只有在你确认后，数据库才会被更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會將原始請求 URL 加入所選的憑證。只有在你確認後，資料庫才會變更。"
          }
        }
      }
    },
    "This database changed in the cloud. Reload before saving again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datenbank wurde in der Cloud geändert. Laden Sie sie vor dem erneuten Sichern neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta base de datos cambió en la nube. Vuelva a cargarla antes de guardar de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données a été modifiée dans le cloud. Rechargez-la avant de l'enregistrer à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo database è cambiato nel cloud. Ricaricalo prima di salvare di nuovo."
          }
