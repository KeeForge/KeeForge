        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雲端服務暫時無法使用。請稍後再試。"
          }
        }
      }
    },
    "The cloud service rejected this file name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cloud-Dienst hat diesen Dateinamen abgelehnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio en la nube rechazó este nombre de archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service cloud a rejeté ce nom de fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio cloud ha rifiutato questo nome di file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドサービスがこのファイル名を受け付けませんでした。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Облачная служба отклонила это имя файла."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云服务拒绝了此文件名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雲端服務拒絕了此檔案名稱。"
          }
        }
      }
    },
    "The current database file does not match the saved key record. Keep the original and new master keys and encrypted backups. Export unsaved changes before closing this session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle Datenbankdatei passt nicht zum gespeicherten Schlüsseleintrag. Bewahre den ursprünglichen und den neuen Hauptschlüssel sowie verschlüsselte Sicherungen auf. Exportiere ungesicherte Änderungen, bevor du diese Sitzung schließt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current database file does not match the saved key record. Keep the original and new master keys and encrypted backups. Export unsaved changes before closing this session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo actual de la base de datos no coincide con el registro de clave guardado. Conserva la clave maestra original, la nueva y las copias de seguridad cifradas. Exporta los cambios sin guardar antes de cerrar esta sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier actuel de la base ne correspond pas à l'enregistrement de clé sauvegardé. Conservez l'ancienne et la nouvelle clé principale ainsi que les sauvegardes chiffrées. Exportez les modifications non enregistrées avant de fermer cette session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file attuale del database non corrisponde al record della chiave salvato. Conserva la chiave principale originale, quella nuova e i backup cifrati. Esporta le modifiche non salvate prima di chiudere questa sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のデータベースファイルは保存済みのキー記録と一致しません。元のマスターキー、新しいマスターキー、暗号化バックアップを保管してください。このセッションを閉じる前に未保存の変更を書き出してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущий файл базы не соответствует сохранённой записи ключа. Сохраните старый и новый мастер-ключи и зашифрованные резервные копии. Экспортируйте несохранённые изменения перед закрытием сеанса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前数据库文件与已存储的密钥记录不符。请保留原始和新主密钥以及加密备份。关闭此会话前，请导出未存储的更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的資料庫檔案與已儲存的密鑰記錄不符。請保留原始和新主密鑰以及加密備份。關閉此工作階段前，請輸出尚未儲存的變更。"
          }
        }
      }
    },
    "The current file's durability is unconfirmed. Keep an encrypted backup before closing this session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die dauerhafte Speicherung der aktuellen Datei ist nicht bestätigt. Behalte vor dem Schließen dieser Sitzung eine verschlüsselte Sicherung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current file's durability is unconfirmed. Keep an encrypted backup before closing this session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La durabilidad del archivo actual no está confirmada. Conserva una copia de seguridad cifrada antes de cerrar esta sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La persistance du fichier actuel n'est pas confirmée. Conservez une sauvegarde chiffrée avant de fermer cette session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La persistenza del file attuale non è confermata. Conserva un backup cifrato prima di chiudere questa sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のファイルの永続性を確認できていません。このセッションを閉じる前に暗号化されたバックアップを保管してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надёжность сохранения текущего файла не подтверждена. Сохраните зашифрованную резервную копию перед закрытием сеанса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前文件的持久性尚未确认。关闭此会话前，请保留加密备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前檔案的持久性尚未確認。關閉此工作階段前，請保留加密備份。"
          }
        }
      }
    },
    "The database already uses the new master key, but its key-file association could not be saved. Keep the new password and key file. Select the key file when unlocking, then set it again in Database Details." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank verwendet bereits den neuen Hauptschlüssel, aber die Zuordnung der Schlüsseldatei konnte nicht gesichert werden. Bewahre das neue Passwort und die Schlüsseldatei auf. Wähle die Schlüsseldatei beim Entsperren aus und lege sie dann in den Datenbankdetails erneut fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The database already uses the new master key, but its key-file association could not be saved. Keep the new password and key file. Select the key file when unlocking, then set it again in Database Details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos ya usa la nueva clave maestra, pero no se pudo guardar su asociación al archivo de clave. Conserva la nueva contraseña y el archivo de clave. Selecciona el archivo de clave al desbloquear y vuelve a asociarlo en Detalles de la base de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données utilise déjà la nouvelle clé principale, mais l'association au fichier clé n'a pas pu être enregistrée. Conservez le nouveau mot de passe et le fichier clé. Sélectionnez le fichier clé au déverrouillage, puis associez-le à nouveau dans Détails de la base de données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il database usa già la nuova chiave principale, ma non è stato possibile salvare l'associazione al file chiave. Conserva la nuova password e il file chiave. Seleziona il file chiave allo sblocco, poi associalo nuovamente in Dettagli database."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースはすでに新しいマスターキーを使用していますが、キーファイルの関連付けを保存できませんでした。新しいパスワードとキーファイルを保管してください。ロック解除時にキーファイルを選び、「データベースの詳細」で再設定してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "База данных уже использует новый мастер-ключ, но привязку файла ключа сохранить не удалось. Сохраните новый пароль и файл ключа. Выберите файл ключа при разблокировке, затем снова задайте его в сведениях о базе данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库已使用新的主密钥，但无法保存密钥文件关联。请保留新密码和密钥文件。解锁时选择密钥文件，然后在“数据库详细信息”中重新设置关联。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫已使用新的主密鑰，但無法儲存密鑰檔案關聯。請保留新密碼和密鑰檔案。解鎖時選擇密鑰檔案，然後在「資料庫詳細資訊」中重新設定關聯。"
          }
        }
      }
    },
    "The database appears corrupted or incomplete." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank scheint beschädigt oder unvollständig zu sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos parece dañada o incompleta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données semble corrompue ou incomplète."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il database sembra danneggiato o incompleto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースが破損しているか、内容が不完全なようです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "База данных повреждена или неполна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库似乎已损坏或不完整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫似乎已損毀或不完整。"
          }
        }
      }
    },
    "The database change is saved, but KeeForge could not confirm completion of its local recovery record. Do not repeat the save. Open Database Details to review any remaining recovery records or snapshots." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankänderung ist gespeichert, aber KeeForge konnte den Abschluss des lokalen Wiederherstellungseintrags nicht bestätigen. Wiederhole die Sicherung nicht. Prüfe verbleibende Wiederherstellungseinträge oder Momentaufnahmen in den Datenbankdetails."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The database change is saved, but KeeForge could not confirm completion of its local recovery record. Do not repeat the save. Open Database Details to review any remaining recovery records or snapshots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cambio en la base de datos está guardado, pero KeeForge no pudo confirmar la finalización de su registro de recuperación local. No repitas el guardado. Abre Detalles de la base de datos para revisar los registros de recuperación o las instantáneas restantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modification de la base est enregistrée, mais KeeForge n'a pas pu confirmer la clôture de son enregistrement de récupération local. Ne répétez pas l'enregistrement. Ouvrez les détails de la base pour examiner les enregistrements de récupération ou instantanés restants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modifica al database è salvata, ma KeeForge non ha potuto confermare la conclusione del relativo record di recupero locale. Non ripetere il salvataggio. Apri Dettagli database per controllare i record di recupero o le istantanee rimasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースの変更は保存済みですが、KeeForgeはローカル復旧記録の完了を確認できませんでした。保存を繰り返さないでください。データベース詳細で残っている復旧記録やスナップショットを確認してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменение базы данных сохранено, но KeeForge не удалось подтвердить завершение локальной записи восстановления. Не повторяйте сохранение. Откройте сведения о базе и проверьте оставшиеся записи восстановления или снимки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库更改已存储，但 KeeForge 无法确认其本地恢复记录是否已完成。请勿重复存储。请打开数据库详情，查看剩余的恢复记录或快照。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫變更已儲存，但 KeeForge 無法確認其本機復原記錄是否已完成。請勿重複儲存。請開啟資料庫詳細資訊，查看剩餘的復原記錄或快照。"
          }
        }
      }
    },
    "The database contains a protected value that could not be decoded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank enthält einen geschützten Wert, der nicht dekodiert werden konnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos contiene un valor protegido que no se pudo descodificar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données contient une valeur protégée qui n'a pas pu être décodée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il database contiene un valore protetto che non è stato possibile decodificare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースに、デコードできない保護された値が含まれています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "База данных содержит защищённое значение, которое не удалось декодировать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库包含无法解码的受保护值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫包含無法解碼的受保護值。"
          }
        }
      }
    },
    "The database contains an unsupported character (%@). Remove it from your text before saving." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank enthält ein nicht unterstütztes Zeichen (%@). Entferne es vor dem Speichern aus deinem Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The database contains an unsupported character (%@). Remove it from your text before saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos contiene un carácter no compatible (%@). Elimínalo del texto antes de guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données contient un caractère non pris en charge (%@). Supprimez-le de votre texte avant d’enregistrer."
