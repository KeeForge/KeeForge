    "Legacy KDBX 3.1 databases can be opened, but KeeForge only allows them in read-only mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere KDBX-3.1-Datenbanken können geöffnet werden, KeeForge lässt sie jedoch nur im schreibgeschützten Modus zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las bases de datos KDBX 3.1 antiguas se pueden abrir, pero KeeForge solo las permite en modo de solo lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les anciennes bases de données KDBX 3.1 peuvent être ouvertes, mais KeeForge ne les autorise qu'en mode lecture seule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I vecchi database KDBX 3.1 possono essere aperti, ma KeeForge li consente solo in modalità di sola lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "従来の KDBX 3.1 データベースも開けますが、KeeForge では読み取り専用でのみ利用できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устаревшие базы данных KDBX 3.1 можно открыть, но KeeForge разрешает работать с ними только в режиме чтения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以打开旧版 KDBX 3.1 数据库，但 KeeForge 仅允许以只读模式使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以開啟舊版 KDBX 3.1 資料庫，但 KeeForge 僅允許以唯讀模式使用。"
          }
        }
      }
    },
