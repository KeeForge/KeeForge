          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupero del salvataggio locale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカル保存の復旧"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление локального сохранения"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地存储恢复"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本機儲存復原"
          }
        }
