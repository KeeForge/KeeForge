    },
    "The database file changed since it was opened. Reload the database and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei wurde seit dem Öffnen geändert. Lade die Datenbank neu und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de base de datos cambió desde que se abrió. Recarga la base de datos e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données a été modifié depuis son ouverture. Rechargez la base de données et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file del database è cambiato da quando è stato aperto. Ricarica il database e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースファイルは、開いたあとに変更されています。データベースを再読み込みしてから、もう一度お試しください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл базы данных изменился после открытия. Перезагрузите базу данных и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库文件在打开后发生了更改。请重新加载数据库后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫檔案在開啟後已變更。請重新載入資料庫後再試一次。"
          }
        }
      }
    },
    "The database file could not be located." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankdatei konnte nicht gefunden werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo localizar el archivo de la base de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données est introuvable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile individuare il file del database."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースファイルの場所を特定できませんでした。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось найти файл базы данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
