        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette base de données est en lecture seule. Ouvrez KeeForge pour activer la modification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
