          }
        }
      }
    },
    "This key-file preference is out of date or blocked by local recovery. Review Database Details before choosing again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Schlüsseldatei-Auswahl ist veraltet oder durch die lokale Wiederherstellung gesperrt. Prüfe die Datenbankdetails, bevor du erneut wählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This key-file preference is out of date or blocked by local recovery. Review Database Details before choosing again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta preferencia de archivo de clave está desactualizada o bloqueada por la recuperación local. Revisa los detalles de la base de datos antes de volver a elegir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette préférence de fichier clé est périmée ou bloquée par la récupération locale. Consultez les détails de la base de données avant de choisir à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa preferenza del file chiave è obsoleta o bloccata dal recupero locale. Controlla i dettagli del database prima di scegliere di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このキーファイルの設定は古くなっているか、ローカル復旧によってブロックされています。選び直す前にデータベースの詳細を確認してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это предпочтение файла ключа устарело или заблокировано локальным восстановлением. Проверьте сведения о базе данных перед новым выбором."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此密钥文件偏好设置已过期或被本地恢复阻止。重新选择前请查看数据库详情。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此金鑰檔案偏好設定已過期或遭本機復原阻擋。重新選擇前請查看資料庫詳細資訊。"
          }
        }
      }
    },
    "This passkey request isn't supported." : {
