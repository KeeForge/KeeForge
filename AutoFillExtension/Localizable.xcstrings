    },
    "The file is damaged: a quoted value that starts in row %lld never ends. Export your passwords again and retry." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei ist beschädigt: Ein Wert in Anführungszeichen, der in Zeile %lld beginnt, endet nie. Exportiere deine Passwörter erneut und versuche es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
