<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>KeeForge AutoFill</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!--
			 macOS 26.5 SDK capability findings (verified against the
			 AuthenticationServices headers):
			   * ProvidesPasswords / ProvidesPasskeys: available on macOS 14 -> advertised.
			   * ProvidesOneTimeCodes: the OTC APIs (ASOneTimeCodeCredential,
			     ASOneTimeCodeCredentialRequest, completeOneTimeCodeRequest(using:))
			     are macos(15.0)+, NOT macOS 14. Per the slice guardrail we only
			     carry a capability key that exists on the macOS 14 floor, so OTC
			     is deferred here (the coordinator's OTC paths still compile behind
			     `@available(macOS 15.0, *)` and can be flipped on later).
			   * SupportsSavePasswordCredentials / SupportsGeneratePasswordCredentials
			     (+ ...WithUI): the underlying request types are
			     `API_UNAVAILABLE(macos)` on every macOS version -> intentionally omitted.
			-->
			<key>ASCredentialProviderExtensionCapabilities</key>
			<dict>
				<key>ProvidesPasswords</key>
				<true/>
				<key>ProvidesPasskeys</key>
				<true/>
			</dict>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.authentication-services-credential-provider-ui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).CredentialProviderViewController</string>
	</dict>
</dict>
</plist>
