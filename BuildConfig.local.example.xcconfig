// Copy this file to BuildConfig.local.xcconfig and replace the placeholder
// values before building or running the app.
DROPBOX_APP_KEY = YOUR_DROPBOX_APP_KEY
ONEDRIVE_CLIENT_ID = YOUR_ONEDRIVE_CLIENT_ID

// Your Apple Developer team. Not required to build and run locally with
// automatic signing on a personal team, but an archive needs it.
// DEVELOPMENT_TEAM = YOURTEAMID

// Sparkle, direct-download (Developer ID) channel only. The Mac App Store
// target does not link Sparkle and ignores both values, so leaving these unset
// is correct unless you are producing a notarized direct build.
// SUFeedURL must be HTTPS. SPARKLE_PUBLIC_ED_KEY is the *public* half printed by
// Sparkle's generate_keys tool — the private key belongs in the login keychain
// and must never be committed or echoed into CI logs.
// SPARKLE_FEED_URL = https://example.com/keeforge/appcast.xml
// SPARKLE_PUBLIC_ED_KEY = YOUR_SPARKLE_PUBLIC_ED_KEY
